      "html": "<section class=\"py-24 bg-[var(--bg-primary)] text-[var(--text-primary)] font-sans antialiased border-t border-b border-[var(--border-color)]\" data-kid=\"1\" data-name=\"core skills section\">\n    <div class=\"max-w-[1100px] mx-auto px-6\" data-kid=\"1-1\" data-name=\"section container\">\n        <div class=\"flex flex-col md:flex-row gap-8 md:items-end mb-16\" data-kid=\"1-1-1\" data-name=\"section header wrapper\">\n            <h2 class=\"text-6xl md:text-8xl font-black uppercase leading-none tracking-tighter w-full md:w-1/2\" data-kid=\"1-1-1-1\" data-name=\"section heading\">\n                Core\n                <br data-kid=\"1-1-1-1-1\" data-name=\"line break\"/>\n                Skills\n            </h2>\n            <div class=\"w-full md:w-1/2 md:pb-4 text-[var(--text-secondary)] text-lg md:text-xl font-medium\" data-kid=\"1-1-1-2\" data-name=\"section description container\">\n                <p data-kid=\"1-1-1-2-1\" data-name=\"section description text\">\n                    A comprehensive overview of my technical capabilities and creative disciplines, structured for clarity and precision.\n                </p>\n            </div>\n        </div>\n        <!-- Bento Grid -->\n        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-0 border-t border-l border-[var(--border-color)]\" data-kid=\"1-1-2\" data-name=\"bento grid container\">\n            <!-- Primary Area (2x2) -->\n            <div class=\"md:col-span-2 md:row-span-2 p-8 md:p-12 border-r border-b border-[var(--border-color)] bg-[var(--bg-secondary)] hover:bg-[var(--bg-card-hover)] transition-colors duration-300\" data-kid=\"1-1-2-1\" data-name=\"primary skills card\">\n                <div class=\"h-full flex flex-col justify-between\" data-kid=\"1-1-2-1-1\" data-name=\"primary skills content wrapper\">\n                    <div class=\"mb-12\" data-kid=\"1-1-2-1-1-1\" data-name=\"primary skills text container\">\n                        <span class=\"inline-block px-3 py-1 bg-[var(--text-primary)] text-[var(--bg-primary)] text-xs font-bold uppercase tracking-wider mb-6\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"primary focus tag\">\n                            Primary Focus\n                        </span>\n                        <h3 class=\"text-4xl font-bold mb-4 tracking-tight leading-tight\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"primary skills heading\">\n                            Frontend Development\n                        </h3>\n                        <p class=\"text-[var(--text-secondary)] text-lg leading-relaxed max-w-md\" data-kid=\"1-1-2-1-1-1-3\" data-name=\"primary skills description\">\n                            Building robust, scalable, and pixel-perfect user interfaces using modern web technologies.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-wrap gap-2\" data-kid=\"1-1-2-1-1-2\" data-name=\"skill tags container\">\n                        <span class=\"px-4 py-2 border border-[var(--border-color)] text-sm font-semibold\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"react skill tag\">\n                            React\n                        </span>\n                        <span class=\"px-4 py-2 border border-[var(--border-color)] text-sm font-semibold\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"nextjs skill tag\">\n                            Next.js\n                        </span>\n                        <span class=\"px-4 py-2 border border-[var(--border-color)] text-sm font-semibold\" data-kid=\"1-1-2-1-1-2-3\" data-name=\"typescript skill tag\">\n                            TypeScript\n                        </span>\n                        <span class=\"px-4 py-2 border border-[var(--border-color)] text-sm font-semibold\" data-kid=\"1-1-2-1-1-2-4\" data-name=\"tailwind css skill tag\">\n                            Tailwind CSS\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Secondary Area 1 -->\n            <div class=\"md:col-span-1 p-8 border-r border-b border-[var(--border-color)] hover:bg-[var(--bg-card-hover)] transition-colors duration-300\" data-kid=\"1-1-2-2\" data-name=\"ui/ux skills card\">\n                <h4 class=\"text-xl font-bold mb-4 tracking-tight\" data-kid=\"1-1-2-2-1\" data-name=\"ui/ux skills heading\">\n                    UI/UX Design\n                </h4>\n                <ul class=\"space-y-3 text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-2\" data-name=\"ui/ux skills list\">\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-2-1\" data-name=\"wireframing list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"bullet icon\">\n                        </span>\n                        Wireframing\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-2-2\" data-name=\"prototyping list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"bullet icon\">\n                        </span>\n                        Prototyping\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-2-3\" data-name=\"design systems list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"bullet icon\">\n                        </span>\n                        Design Systems\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-2-4\" data-name=\"figma list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-2-2-4-1\" data-name=\"bullet icon\">\n                        </span>\n                        Figma\n                    </li>\n                </ul>\n            </div>\n            <!-- Secondary Area 2 -->\n            <div class=\"md:col-span-1 p-8 border-r border-b border-[var(--border-color)] hover:bg-[var(--bg-card-hover)] transition-colors duration-300\" data-kid=\"1-1-2-3\" data-name=\"backend skills card\">\n                <h4 class=\"text-xl font-bold mb-4 tracking-tight\" data-kid=\"1-1-2-3-1\" data-name=\"backend skills heading\">\n                    Backend & Data\n                </h4>\n                <ul class=\"space-y-3 text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-2\" data-name=\"backend skills list\">\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-2-1\" data-name=\"node list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"bullet icon\">\n                        </span>\n                        Node.js\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-2-2\" data-name=\"express list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"bullet icon\">\n                        </span>\n                        Express\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-2-3\" data-name=\"postgresql list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-3-2-3-1\" data-name=\"bullet icon\">\n                        </span>\n                        PostgreSQL\n                    </li>\n                    <li class=\"flex items-center gap-2\" data-kid=\"1-1-2-3-2-4\" data-name=\"api list item\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--text-primary)] inline-block\" data-kid=\"1-1-2-3-2-4-1\" data-name=\"bullet icon\">\n                        </span>\n                        REST APIs\n                    </li>\n                </ul>\n            </div>\n            <!-- Secondary Area 3 -->\n            <div class=\"md:col-span-2 p-8 border-r border-b border-[var(--border-color)] hover:bg-[var(--bg-card-hover)] transition-colors duration-300 flex flex-col sm:flex-row gap-8 justify-between items-start sm:items-center\" data-kid=\"1-1-2-4\" data-name=\"devops skills card\">\n                <div data-kid=\"1-1-2-4-1\" data-name=\"devops description container\">\n                    <h4 class=\"text-xl font-bold mb-2 tracking-tight\" data-kid=\"1-1-2-4-1-1\" data-name=\"devops heading\">\n                        Tools & DevOps\n                    </h4>\n                    <p class=\"text-[var(--text-secondary)] text-sm max-w-sm\" data-kid=\"1-1-2-4-1-2\" data-name=\"devops tools list\">\n                        Git, GitHub Actions, Docker, Vercel, Netlify, Webpack, Vite\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-2 gap-x-8 gap-y-2 text-sm font-mono text-[var(--text-muted)]\" data-kid=\"1-1-2-4-2\" data-name=\"devops commands grid\">\n                    <span data-kid=\"1-1-2-4-2-1\" data-name=\"git command\">\n                        > git commit -m\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-2\" data-name=\"docker command\">\n                        > docker build .\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-3\" data-name=\"npm command\">\n                        > npm run deploy\n                    </span>\n                    <span data-kid=\"1-1-2-4-2-4\" data-name=\"pnpm command\">\n                        > pnpm dev\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
