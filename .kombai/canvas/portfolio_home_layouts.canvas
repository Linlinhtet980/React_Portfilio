      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;700&display=swap');\n\n  body {\n    background-color: #F5F5F5;\n    color: #111111;\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .font-anton {\n    font-family: 'Anton', sans-serif;\n  }\n  .font-mono {\n    font-family: monospace;\n  }\n\n  /* Hard offset shadow */\n  .brutalist-shadow {\n    box-shadow: 12px 12px 0px #111111;\n  }\n  \n  .btn-shadow {\n    box-shadow: 8px 8px 0px #111111;\n  }\n  .btn-shadow:hover {\n    box-shadow: 4px 4px 0px #111111;\n  }\n\n  /* Marquee track setup */\n  .marquee-container {\n    display: flex;\n    white-space: nowrap;\n    overflow: hidden;\n    width: 100vw;\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n  }\n  \n  .marquee-track {\n    display: flex;\n    flex-shrink: 0;\n  }\n</style>\n<div class=\"min-h-screen p-4 md:p-8 flex flex-col items-center max-w-[1440px] mx-auto w-full\" data-kid=\"1\" data-name=\"page layout container\">\n    <main class=\"w-full border-[4px] border-[#111111] bg-[#F5F5F5] brutalist-shadow flex flex-col overflow-hidden relative\" data-kid=\"1-1\" data-name=\"main portfolio layout card\">\n        <!-- Top Nav / Header -->\n        <header class=\"border-b-[4px] border-[#111111] px-6 py-4 flex justify-between items-center bg-white z-20 relative shrink-0\" data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n            <div class=\"font-anton text-2xl md:text-3xl uppercase tracking-wider\" data-kid=\"1-1-1-1\" data-name=\"portfolio brand name text\">\n                PORTFOLIO.SYS\n            </div>\n            <div class=\"font-bold text-xs md:text-sm uppercase tracking-widest bg-[#111111] text-[#FFD800] px-3 py-1 border-2 border-[#111]\" data-kid=\"1-1-1-2\" data-name=\"version badge tag\">\n                v.2.0.4\n            </div>\n        </header>\n        <!-- HERO SECTION (#brutalist) -->\n        <section class=\"relative bg-[#FFD800] border-b-[4px] border-[#111111] min-h-[70vh] flex flex-col justify-end p-6 md:p-16 overflow-hidden shrink-0\" data-kid=\"1-1-2\" data-name=\"hero section\">\n            <!-- Decorative Corners (#shape cross) -->\n            <img alt=\"cross\" class=\"absolute top-6 left-6 w-8 h-8 opacity-90\" data-kid=\"1-1-2-1\" data-name=\"decorative top-left cross icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/cross-mark.svg\" style=\"filter: invert(100%) sepia(100%) saturate(0%) hue-rotate(288deg) brightness(0%) contrast(102%);\"/>\n            <img alt=\"cross\" class=\"absolute top-6 right-6 w-8 h-8 opacity-90\" data-kid=\"1-1-2-2\" data-name=\"decorative top-right cross icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/cross-mark.svg\" style=\"filter: invert(100%) sepia(100%) saturate(0%) hue-rotate(288deg) brightness(0%) contrast(102%);\"/>\n            <img alt=\"cross\" class=\"absolute bottom-6 left-6 w-8 h-8 opacity-90 hidden md:block\" data-kid=\"1-1-2-3\" data-name=\"decorative bottom-left cross icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/cross-mark.svg\" style=\"filter: invert(100%) sepia(100%) saturate(0%) hue-rotate(288deg) brightness(0%) contrast(102%);\"/>\n            <!-- Headline (#anime-text-scramble target) -->\n            <h1 class=\"scramble-target font-anton text-[18vw] leading-[0.8] tracking-tight uppercase text-[#111111] max-w-[95%] z-10 mix-blend-multiply select-none\" data-dynamic=\"true\" data-kid=\"1-1-2-4\" data-name=\"scrambling hero headline text\" data-reason=\"text content replaced during scramble animation script\">\n                CREATIVE\n                <br data-kid=\"1-1-2-4-1\" data-name=\"line break element\"/>\n                DIRECTOR\n            </h1>\n            <p class=\"font-bold text-lg md:text-2xl uppercase tracking-widest mt-6 max-w-lg border-l-[4px] border-[#111] pl-4 z-10 text-[#111]\" data-kid=\"1-1-2-5\" data-name=\"hero subheadline description text\">\n                Forging digital reality.\n                <br data-kid=\"1-1-2-5-1\" data-name=\"line break element\"/>\n                Zero compromise.\n            </p>\n            <!-- CTA Button (#hard-offset) -->\n            <button class=\"absolute bottom-6 right-6 md:bottom-16 md:right-16 bg-white border-[4px] border-[#111111] text-[#111111] font-anton text-2xl md:text-4xl uppercase px-8 py-4 btn-shadow hover:translate-x-[4px] hover:translate-y-[4px] hover:bg-[#111111] hover:text-[#FFD800] transition-all z-20 cursor-pointer\" data-kid=\"1-1-2-6\" data-name=\"call-to-action hire-me button\">\n                Hire Me\n            </button>\n        </section>\n        <!-- INTRODUCTION (#giant-marquee) -->\n        <section class=\"relative bg-white border-b-[4px] border-[#111111] py-24 md:py-48 flex items-center justify-center overflow-hidden shrink-0\" data-kid=\"1-1-3\" data-name=\"introduction bio section\">\n            <!-- Marquee Background (#anime-marquee-logo) -->\n            <div class=\"absolute inset-0 flex items-center justify-center opacity-[0.07] pointer-events-none z-0\" data-kid=\"1-1-3-1\" data-name=\"marquee background container\">\n                <div class=\"marquee-container\" data-kid=\"1-1-3-1-1\" data-name=\"marquee movement wrapper\">\n                    <div class=\"marquee-track font-anton text-[150px] md:text-[250px] uppercase text-[#111111]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-1-1\" data-name=\"marquee track\" data-reason=\"track x-position updated by animation script for infinite scroll\">\n                        <span class=\"px-8\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"marquee text item one\">\n                            UI DESIGN • ART DIRECTION • STRATEGY •\n                        </span>\n                        <span class=\"px-8\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"marquee text item two\">\n                            UI DESIGN • ART DIRECTION • STRATEGY •\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Bio Card -->\n            <div class=\"relative z-10 flex flex-col md:flex-row border-[4px] border-[#111111] bg-[#F5F5F5] mx-4 max-w-[90%] md:max-w-4xl btn-shadow\" data-kid=\"1-1-3-2\" data-name=\"bio card container\">\n                <div class=\"w-full md:w-[350px] shrink-0 border-b-[4px] md:border-b-0 md:border-r-[4px] border-[#111111] bg-[#111111] relative p-3\" data-kid=\"1-1-3-2-1\" data-name=\"portrait image container\">\n                    <!-- Raw flash photography portrait -->\n                    <img alt=\"High contrast portrait by Rachel McDermott\" class=\"w-full h-full object-cover grayscale contrast-125 brightness-90 border-[2px] border-[#111]\" data-kid=\"1-1-3-2-1-1\" data-name=\"raw portrait photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1506863530036-1efeddceb993?auto=format&w=800&q=80&fit=crop\"/>\n                    <div class=\"absolute top-5 right-5 bg-[#FFD800] text-[#111] font-bold text-xs px-2 py-1 uppercase border-2 border-[#111]\" data-kid=\"1-1-3-2-1-2\" data-name=\"raw image status badge\">\n                        RAW_IMG\n                    </div>\n                </div>\n                <div class=\"p-8 md:p-12 flex flex-col justify-center\" data-kid=\"1-1-3-2-2\" data-name=\"biography text container\">\n                    <div class=\"flex items-center gap-3 mb-6 border-b-2 border-[#111] pb-4\" data-kid=\"1-1-3-2-2-1\" data-name=\"status indicator row\">\n                        <div class=\"w-4 h-4 bg-[#FFD800] rounded-full animate-pulse border-2 border-[#111]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"pulsing activity status dot\">\n                        </div>\n                        <span class=\"font-mono font-bold text-sm uppercase tracking-widest\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"status message text\">\n                            Status: Actively building\n                        </span>\n                    </div>\n                    <p class=\"font-mono text-sm md:text-base leading-relaxed font-bold text-[#111]\" data-kid=\"1-1-3-2-2-2\" data-name=\"biography paragraph\">\n                        > I construct brutal, uncompromising digital experiences.\n                        <br data-kid=\"1-1-3-2-2-2-1\" data-name=\"line break element\"/>\n                        <br data-kid=\"1-1-3-2-2-2-2\" data-name=\"line break element\"/>\n                        > Rejecting the polished, soulless corporate aesthetic in favor of raw structure and maximal impact.\n                        <br data-kid=\"1-1-3-2-2-2-3\" data-name=\"line break element\"/>\n                        <br data-kid=\"1-1-3-2-2-2-4\" data-name=\"line break element\"/>\n                        > Design is not decoration. It is architecture.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- QUICK LINKS / PROJECTS (#project-list & #gsap-mask-wipe) -->\n        <section class=\"bg-[#F5F5F5] flex flex-col w-full z-10 relative shrink-0\" data-kid=\"1-1-4\" data-name=\"projects and links section\">\n            <div class=\"px-6 md:px-12 py-8 border-b-[4px] border-[#111111] bg-[#111111] text-white\" data-kid=\"1-1-4-1\" data-name=\"projects section header\">\n                <h3 class=\"font-mono font-bold text-xl uppercase tracking-widest text-[#FFD800]\" data-kid=\"1-1-4-1-1\" data-name=\"index title text\">\n                    > Index_\n                </h3>\n            </div>\n            <!-- Link Row 1 -->\n            <a class=\"link-row group relative block border-b-[4px] border-[#111111] p-6 md:p-12 bg-white overflow-hidden decoration-none text-[#111111]\" data-kid=\"1-1-4-2\" data-name=\"selected works link row\" href=\"#\">\n                <!-- Hover Bg Layer -->\n                <div class=\"absolute inset-0 bg-[#111111] origin-top scale-y-0 group-hover:scale-y-100 transition-transform duration-500 ease-in-out z-0\" data-kid=\"1-1-4-2-1\" data-name=\"hover background color layer\">\n                </div>\n                <!-- Hover Image -->\n                <img alt=\"Selected Works Project\" class=\"absolute right-0 top-1/2 -translate-y-1/2 w-1/2 md:w-1/3 h-full object-cover opacity-0 group-hover:opacity-60 transition-opacity duration-500 z-0 mix-blend-luminosity grayscale pointer-events-none\" data-kid=\"1-1-4-2-2\" data-name=\"hover background project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35308482/pexels-photo-35308482.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                <div class=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between w-full\" data-kid=\"1-1-4-2-3\" data-name=\"link row content container\">\n                    <h2 class=\"font-anton text-5xl md:text-8xl uppercase tracking-tighter group-hover:text-[#FFD800] transition-colors duration-300\" data-kid=\"1-1-4-2-3-1\" data-name=\"link row title\">\n                        Selected Works\n                    </h2>\n                    <div class=\"flex items-center gap-4 mt-4 md:mt-0 text-[#111] group-hover:text-white transition-colors duration-300\" data-kid=\"1-1-4-2-3-2\" data-name=\"link row detail group\">\n                        <span class=\"font-mono font-bold text-lg md:text-xl border-2 border-current px-4 py-1 bg-white group-hover:bg-transparent\" data-kid=\"1-1-4-2-3-2-1\" data-name=\"project count badge\">\n                            24 Projects\n                        </span>\n                        <svg class=\"w-8 h-8 md:w-10 md:h-10 transform group-hover:translate-x-2 transition-transform duration-300\" data-kid=\"1-1-4-2-3-2-2\" data-name=\"right arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M17 8l4 4m0 0l-4 4m4-4H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"3\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n            </a>\n            <!-- Link Row 2 -->\n            <a class=\"link-row group relative block border-b-[4px] border-[#111111] p-6 md:p-12 bg-white overflow-hidden decoration-none text-[#111111]\" data-kid=\"1-1-4-3\" data-name=\"manifesto link row\" href=\"#\">\n                <!-- Hover Bg Layer -->\n                <div class=\"absolute inset-0 bg-[#111111] origin-top scale-y-0 group-hover:scale-y-100 transition-transform duration-500 ease-in-out z-0\" data-kid=\"1-1-4-3-1\" data-name=\"hover background color layer\">\n                </div>\n                <!-- Hover Image -->\n                <img alt=\"Writing Manifesto\" class=\"absolute right-0 top-1/2 -translate-y-1/2 w-1/2 md:w-1/3 h-full object-cover opacity-0 group-hover:opacity-60 transition-opacity duration-500 z-0 mix-blend-luminosity grayscale pointer-events-none\" data-kid=\"1-1-4-3-2\" data-name=\"hover background project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1518611540400-6b85a0704342?auto=format&w=1200&q=80&fit=crop\"/>\n                <div class=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between w-full\" data-kid=\"1-1-4-3-3\" data-name=\"link row content container\">\n                    <h2 class=\"font-anton text-5xl md:text-8xl uppercase tracking-tighter group-hover:text-[#FFD800] transition-colors duration-300\" data-kid=\"1-1-4-3-3-1\" data-name=\"link row title\">\n                        Manifesto\n                    </h2>\n                    <div class=\"flex items-center gap-4 mt-4 md:mt-0 text-[#111] group-hover:text-white transition-colors duration-300\" data-kid=\"1-1-4-3-3-2\" data-name=\"link row detail group\">\n                        <span class=\"font-mono font-bold text-lg md:text-xl border-2 border-current px-4 py-1 bg-white group-hover:bg-transparent\" data-kid=\"1-1-4-3-3-2-1\" data-name=\"link row detail badge\">\n                            Writing\n                        </span>\n                        <svg class=\"w-8 h-8 md:w-10 md:h-10 transform group-hover:translate-x-2 transition-transform duration-300\" data-kid=\"1-1-4-3-3-2-2\" data-name=\"right arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M17 8l4 4m0 0l-4 4m4-4H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"3\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n            </a>\n            <!-- Link Row 3 -->\n            <a class=\"link-row group relative block border-b-[4px] border-[#111111] p-6 md:p-12 bg-[#FFD800] overflow-hidden decoration-none text-[#111111]\" data-kid=\"1-1-4-4\" data-name=\"contact link row\" href=\"#\">\n                <!-- Hover Bg Layer -->\n                <div class=\"absolute inset-0 bg-[#111111] origin-top scale-y-0 group-hover:scale-y-100 transition-transform duration-500 ease-in-out z-0\" data-kid=\"1-1-4-4-1\" data-name=\"hover background color layer\">\n                </div>\n                <div class=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between w-full\" data-kid=\"1-1-4-4-2\" data-name=\"link row content container\">\n                    <h2 class=\"font-anton text-5xl md:text-8xl uppercase tracking-tighter group-hover:text-[#FFD800] transition-colors duration-300\" data-kid=\"1-1-4-4-2-1\" data-name=\"link row title\">\n                        Contact\n                    </h2>\n                    <div class=\"flex items-center gap-4 mt-4 md:mt-0 text-[#111] group-hover:text-white transition-colors duration-300\" data-kid=\"1-1-4-4-2-2\" data-name=\"link row detail group\">\n                        <span class=\"font-mono font-bold text-lg md:text-xl border-2 border-current px-4 py-1 bg-[#FFD800] group-hover:bg-transparent\" data-kid=\"1-1-4-4-2-2-1\" data-name=\"link row detail badge\">\n                            Connect\n                        </span>\n                        <svg class=\"w-8 h-8 md:w-10 md:h-10 transform group-hover:translate-x-2 transition-transform duration-300\" data-kid=\"1-1-4-4-2-2-2\" data-name=\"right arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M17 8l4 4m0 0l-4 4m4-4H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"3\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n            </a>\n            <!-- Footer -->\n            <footer class=\"p-6 md:p-12 flex flex-col md:flex-row justify-between items-center font-mono font-bold text-sm uppercase bg-white gap-4\" data-kid=\"1-1-4-5\" data-name=\"footer bar\">\n                <span data-kid=\"1-1-4-5-1\" data-name=\"copyright notice text\">\n                    © 2026 BRUTAL PORTFOLIO.\n                </span>\n                <span class=\"bg-[#111] text-[#F5F5F5] px-3 py-1\" data-kid=\"1-1-4-5-2\" data-name=\"system status badge\">\n                    SYSTEM TERMINATED.\n                </span>\n            </footer>\n        </section>\n    </main>\n</div>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import { animate } from 'https://esm.sh/animejs@4';\n    gsap.registerPlugin(ScrollTrigger);\n\n    // #anime-text-scramble implementation\n    // A robust vanilla implementation to guarantee it runs flawlessly within the context.\n    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*';\n    const scrambleElement = document.querySelector('.scramble-target');\n    \n    class TextScrambler {\n        constructor(el) {\n            this.el = el;\n            this.originalText = \"CREATIVE\\nDIRECTOR\"; \n            this.textArray = this.originalText.split('');\n            this.iterations = 0;\n            this.maxIterations = 20; // Controls speed of reveal\n        }\n        start() {\n            this.interval = setInterval(() => {\n                const scrambledArray = this.textArray.map((char, index) => {\n                    if (char === ' ' || char === '\\n') return char;\n                    if (this.iterations > this.maxIterations * (index / this.textArray.length)) {\n                        return char; // Reveal correct character\n                    }\n                    return chars[Math.floor(Math.random() * chars.length)];\n                });\n                \n                let textResult = scrambledArray.join('');\n                textResult = textResult.replace(/\\n/g, '<br>');\n                this.el.innerHTML = textResult;\n                \n                this.iterations++;\n                if (this.iterations > this.maxIterations + 15) {\n                    clearInterval(this.interval);\n                    this.el.innerHTML = \"CREATIVE<br>DIRECTOR\";\n                }\n            }, 50);\n        }\n    }\n    \n    // Start scramble after a short delay\n    setTimeout(() => {\n       if(scrambleElement) new TextScrambler(scrambleElement).start();\n    }, 200);\n\n    // #anime-marquee-logo\n    // Ensure the track wraps perfectly by moving to -50% (half its width, assuming 2 identical children)\n    animate(\".marquee-track\", { \n        x: [\"0%\", \"-50%\"], \n        duration: 20000, \n        loop: true, \n        ease: \"linear\" \n    });\n\n    // #gsap-mask-wipe\n    gsap.utils.toArray('.link-row').forEach(row => {\n        gsap.fromTo(row, \n            { clipPath: \"inset(0 100% 0 0)\" }, \n            { \n                clipPath: \"inset(0 0 0 0)\", \n                duration: 1, \n                ease: \"power3.inOut\",\n                scrollTrigger: {\n                    trigger: row,\n                    start: \"top 95%\",\n                }\n            }\n        );\n    });\n</script>\n",
      "comments": [],
      "created": "2026-09-07T12:37:14.488769+00:00",
      "modified": "2026-09-07T12:37:14.488769+00:00",
      "id": "var_87faaf71078b",
      "viewportScrollY": 1503
    },
    "var_f73f85d26b4a": {
      "type": "variant",
      "label": "Swiss Style",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Inter:wght@400;500;600;700;800;900&display=swap');\n  \n  body {\n    font-family: 'Inter', sans-serif;\n    color: #111111;\n    background-color: #FFFFFF;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n  \n  .display-font {\n    font-family: 'DM Sans', sans-serif;\n  }\n</style>\n<main class=\"w-full bg-white overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Hero Section -->\n    <section class=\"min-h-screen w-full flex flex-col md:flex-row border-b border-[#d0d0cc]\" data-kid=\"1-1\" data-name=\"hero section\">\n        <!-- 1. Narrow dark sidebar -->\n        <div class=\"w-full md:w-20 lg:w-24 bg-[#111111] text-white flex md:flex-col items-center justify-between md:justify-end p-6 md:py-12 shrink-0 border-r border-[#111111] z-20\" data-kid=\"1-1-1\" data-name=\"narrow dark sidebar\">\n            <!-- Mobile name -->\n            <div class=\"md:hidden font-bold tracking-widest uppercase text-sm\" data-kid=\"1-1-1-1\" data-name=\"mobile site name\">\n                S. Studio\n            </div>\n            <!-- Vertical text -->\n            <div class=\"hidden md:block -rotate-90 whitespace-nowrap text-xs tracking-[0.3em] font-medium text-white/70 uppercase origin-center translate-y-12\" data-kid=\"1-1-1-2\" data-name=\"vertical creative director text\">\n                Creative Director\n            </div>\n        </div>\n        <!-- 2. Wide Center Column -->\n        <div class=\"flex-1 flex flex-col justify-center px-6 py-16 md:px-12 lg:px-20 xl:px-24 bg-white relative z-10\" data-kid=\"1-1-2\" data-name=\"center content column\">\n            <div class=\"max-w-4xl relative z-10\" data-kid=\"1-1-2-1\" data-name=\"hero content wrapper\">\n                <div class=\"mb-6 overflow-hidden\" data-kid=\"1-1-2-1-1\" data-name=\"portfolio label container\">\n                    <p class=\"hero-text text-sm font-bold text-[#FE0000] tracking-widest uppercase\" data-kid=\"1-1-2-1-1-1\" data-name=\"portfolio label text\">\n                        Portfolio — 2024\n                    </p>\n                </div>\n                <div class=\"mb-8\" data-kid=\"1-1-2-1-2\" data-name=\"hero headline container\">\n                    <h1 class=\"hero-text display-font text-6xl md:text-8xl lg:text-[9rem] xl:text-[10rem] font-bold leading-[0.85] tracking-tighter text-[#111111] uppercase\" data-kid=\"1-1-2-1-2-1\" data-name=\"hero main headline\">\n                        Form\n                        <br data-kid=\"1-1-2-1-2-1-1\" data-name=\"headline line break 1\"/>\n                        Follows\n                        <br data-kid=\"1-1-2-1-2-1-2\" data-name=\"headline line break 2\"/>\n                        Logic\n                    </h1>\n                </div>\n                <div class=\"mb-12\" data-kid=\"1-1-2-1-3\" data-name=\"hero description container\">\n                    <p class=\"hero-text text-lg md:text-xl text-gray-700 max-w-md font-medium leading-relaxed\" data-kid=\"1-1-2-1-3-1\" data-name=\"hero description text\">\n                        Crafting clear, objective, and timeless digital structures through strict grid systems.\n                    </p>\n                </div>\n                <div data-kid=\"1-1-2-1-4\" data-name=\"call-to-action button container\">\n                    <div class=\"hero-text inline-block\" data-kid=\"1-1-2-1-4-1\" data-name=\"call-to-action button wrapper\">\n                        <a class=\"inline-flex items-center gap-4 text-[#111111] hover:text-[#FE0000] font-bold uppercase tracking-wider group transition-colors duration-300 pb-2 border-b-2 border-[#111111] hover:border-[#FE0000]\" data-kid=\"1-1-2-1-4-1-1\" data-name=\"explore work button\" href=\"#bento-section\">\n                            <span data-kid=\"1-1-2-1-4-1-1-1\" data-name=\"explore work button text\">\n                                Explore Work\n                            </span>\n                            <svg class=\"w-5 h-5 transform group-hover:translate-x-2 transition-transform duration-300\" data-kid=\"1-1-2-1-4-1-1-2\" data-name=\"arrow right icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                <path d=\"M17 8l4 4m0 0l-4 4m4-4H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2.5\">\n                                </path>\n                            </svg>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <!-- Faint grid background -->\n            <div class=\"absolute inset-0 pointer-events-none opacity-[0.03]\" data-kid=\"1-1-2-2\" data-name=\"faint grid background\" style=\"background-image: linear-gradient(#111 1px, transparent 1px), linear-gradient(90deg, #111 1px, transparent 1px); background-size: 4rem 4rem;\">\n            </div>\n        </div>\n        <!-- 3. Right column image -->\n        <div class=\"w-full md:w-1/3 lg:w-[40%] h-[50vh] md:h-auto shrink-0 relative overflow-hidden bg-gray-100 border-l border-[#d0d0cc]\" data-kid=\"1-1-3\" data-name=\"hero image column\">\n            <img alt=\"Bekah Allmark on Unsplash\" class=\"absolute inset-0 w-full h-full object-cover object-center grayscale\" data-kid=\"1-1-3-1\" data-name=\"hero portrait image\" decoding=\"async\" id=\"hero-image\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1598897516650-e4dc73d8e417?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxCbGFjayUyMGFuZCUyMHdoaXRlJTIwcG9ydHJhaXQlMjBvZiUyMGElMjBkZXNpZ25lciUyMGxvb2tpbmclMjB0aG91Z2h0ZnVsbHklMjBvZmYlMjBjYW1lcmElMjBtaW5pbWFsJTIwYmFja2dyb3VuZHxlbnwwfHx8fDE3ODg3ODQ2MDd8MA&ixlib=rb-4.1.0&q=85&auto=format&w=800&fit=crop\"/>\n        </div>\n    </section>\n    <!-- Intro Section -->\n    <section class=\"py-24 md:py-32 px-6 md:px-12 lg:px-16 bg-white border-b border-[#d0d0cc]\" data-kid=\"1-2\" data-name=\"intro section\">\n        <div class=\"max-w-2xl mx-auto text-lg md:text-xl font-medium leading-[1.8] text-[#111111]\" data-kid=\"1-2-1\" data-name=\"intro text content container\">\n            <div class=\"intro-text\" data-kid=\"1-2-1-1\" data-name=\"intro paragraph container\">\n                <p class=\"mb-16\" data-kid=\"1-2-1-1-1\" data-name=\"intro descriptive paragraph\">\n                    I believe that design is not merely about ornamentation; it is the rigorous process of stripping away the inessential until only the pure, functional core remains. My methodology is deeply rooted in the International Typographic Style, where objective clarity is always prioritized over subjective expression.\n                </p>\n            </div>\n            <!-- Pull Quote -->\n            <div class=\"pull-quote my-24 -mx-4 md:-mx-16 lg:-mx-32 py-16 border-y border-[#111111]\" data-kid=\"1-2-1-2\" data-name=\"pull quote section\">\n                <blockquote class=\"display-font text-3xl md:text-5xl lg:text-7xl font-bold leading-[1.05] text-[#111111] text-center tracking-tighter uppercase\" data-kid=\"1-2-1-2-1\" data-name=\"pull quote text\">\n                    \"Clarity is the ultimate\n                    <br data-kid=\"1-2-1-2-1-1\" data-name=\"pull quote line break\">\n                        <span class=\"text-[#FE0000]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"pull quote emphasized text\">\n                            sophistication.\n                        </span>\n                        \"\n                    </br>\n                </blockquote>\n            </div>\n            <div class=\"intro-text\" data-kid=\"1-2-1-3\" data-name=\"outro paragraph container\">\n                <p data-kid=\"1-2-1-3-1\" data-name=\"outro descriptive paragraph\">\n                    By employing strict grid systems, asymmetrical layouts, and robust sans-serif typography, I build structures that guide the user effortlessly. The ultimate goal is to present information in its most direct, comprehensible form—creating systems that are both timeless and relentlessly functional.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- Quick Links Bento Section -->\n    <section class=\"py-24 px-6 md:px-12 lg:px-24 bg-gray-50\" data-kid=\"1-3\" data-name=\"directory bento section\" id=\"bento-section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-3-1\" data-name=\"directory section inner container\">\n            <div class=\"mb-12 flex items-center justify-between\" data-kid=\"1-3-1-1\" data-name=\"directory header\">\n                <h2 class=\"display-font text-sm font-bold uppercase tracking-widest text-[#111111]\" data-kid=\"1-3-1-1-1\" data-name=\"directory title\">\n                    Directory\n                </h2>\n                <div class=\"h-[1px] flex-1 bg-[#d0d0cc] mx-6\" data-kid=\"1-3-1-1-2\" data-name=\"directory divider line\">\n                </div>\n                <span class=\"text-sm font-bold uppercase tracking-widest text-[#FE0000]\" data-kid=\"1-3-1-1-3\" data-name=\"directory count\">\n                    04\n                </span>\n            </div>\n            <!-- Grid Container with 1px gap -->\n            <div class=\"grid grid-cols-1 md:grid-cols-4 auto-rows-[250px] md:auto-rows-[300px] gap-[1px] bg-[#d0d0cc] border border-[#d0d0cc]\" data-kid=\"1-3-1-2\" data-name=\"bento grid container\">\n                <!-- Largest Cell -->\n                <div class=\"bento-wrapper md:col-span-2 md:row-span-2 h-full\" data-kid=\"1-3-1-2-1\" data-name=\"selected works card\">\n                    <a class=\"block h-full bg-white relative p-8 md:p-12 group transition-colors duration-500 hover:bg-[#111111] hover:text-white overflow-hidden\" data-kid=\"1-3-1-2-1-1\" data-name=\"selected works link\" href=\"#work\">\n                        <div class=\"h-full flex flex-col justify-between relative z-10\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"selected works content wrapper\">\n                            <div class=\"text-[#FE0000] font-bold text-sm tracking-widest uppercase\" data-kid=\"1-3-1-2-1-1-1-1\" data-name=\"selected works label\">\n                                01 / Portfolio\n                            </div>\n                            <div data-kid=\"1-3-1-2-1-1-1-2\" data-name=\"selected works heading area\">\n                                <h3 class=\"display-font text-5xl md:text-6xl lg:text-7xl font-bold leading-[0.9] uppercase tracking-tighter mb-6\" data-kid=\"1-3-1-2-1-1-1-2-1\" data-name=\"selected works title\">\n                                    Selected\n                                    <br data-kid=\"1-3-1-2-1-1-1-2-1-1\" data-name=\"selected works title break\"/>\n                                    Works\n                                </h3>\n                                <div class=\"inline-flex items-center gap-3 text-sm uppercase tracking-widest font-bold\" data-kid=\"1-3-1-2-1-1-1-2-2\" data-name=\"selected works action link\">\n                                    <span class=\"group-hover:text-[#FE0000] transition-colors duration-300\" data-kid=\"1-3-1-2-1-1-1-2-2-1\" data-name=\"selected works link text\">\n                                        Explore Projects\n                                    </span>\n                                    <svg class=\"w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300\" data-kid=\"1-3-1-2-1-1-1-2-2-2\" data-name=\"arrow right icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M17 8l4 4m0 0l-4 4m4-4H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                                        </path>\n                                    </svg>\n                                </div>\n                            </div>\n                        </div>\n                        <!-- Corner icon -->\n                        <div class=\"absolute top-8 right-8 md:top-12 md:right-12 text-[#111111] group-hover:text-white transform group-hover:translate-x-2 group-hover:-translate-y-2 transition-transform duration-500\" data-kid=\"1-3-1-2-1-1-2\" data-name=\"external link icon\">\n                            <svg class=\"w-10 h-10\" data-kid=\"1-3-1-2-1-1-2-1\" data-name=\"external link icon path\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                <path d=\"M17 7l-10 10M17 7H7M17 7v10\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"1.5\">\n                                </path>\n                            </svg>\n                        </div>\n                    </a>\n                </div>\n                <!-- Cell 2 -->\n                <div class=\"bento-wrapper md:col-span-2 h-full\" data-kid=\"1-3-1-2-2\" data-name=\"about me card\">\n                    <a class=\"block h-full bg-white relative p-8 md:p-12 group transition-colors duration-500 hover:bg-[#111111] hover:text-white\" data-kid=\"1-3-1-2-2-1\" data-name=\"about me link\" href=\"#about\">\n                        <div class=\"h-full flex flex-col justify-between\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"about me content wrapper\">\n                            <div class=\"text-[#FE0000] font-bold text-sm tracking-widest uppercase\" data-kid=\"1-3-1-2-2-1-1-1\" data-name=\"about me label\">\n                                02 / Profile\n                            </div>\n                            <div class=\"flex justify-between items-end\" data-kid=\"1-3-1-2-2-1-1-2\" data-name=\"about me footer area\">\n                                <h3 class=\"display-font text-4xl lg:text-5xl font-bold uppercase tracking-tighter leading-none\" data-kid=\"1-3-1-2-2-1-1-2-1\" data-name=\"about me title\">\n                                    About\n                                    <br data-kid=\"1-3-1-2-2-1-1-2-1-1\" data-name=\"about me title break\"/>\n                                    Me\n                                </h3>\n                                <div class=\"w-12 h-12 rounded-full border border-[#111111] group-hover:border-white flex items-center justify-center group-hover:bg-white group-hover:text-[#111111] transition-all duration-500\" data-kid=\"1-3-1-2-2-1-1-2-2\" data-name=\"about me arrow button\">\n                                    <svg class=\"w-5 h-5 transform group-hover:rotate-45 transition-transform duration-500\" data-kid=\"1-3-1-2-2-1-1-2-2-1\" data-name=\"about me arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M14 5l7 7m0 0l-7 7m7-7H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                                        </path>\n                                    </svg>\n                                </div>\n                            </div>\n                        </div>\n                    </a>\n                </div>\n                <!-- Cell 3 -->\n                <div class=\"bento-wrapper h-full\" data-kid=\"1-3-1-2-3\" data-name=\"contact card\">\n                    <a class=\"block h-full bg-white relative p-8 md:p-12 group transition-colors duration-500 hover:bg-[#FE0000] hover:text-white overflow-hidden\" data-kid=\"1-3-1-2-3-1\" data-name=\"contact link\" href=\"#contact\">\n                        <div class=\"h-full flex flex-col justify-between relative z-10\" data-kid=\"1-3-1-2-3-1-1\" data-name=\"contact content wrapper\">\n                            <div class=\"text-[#111111] group-hover:text-white font-bold text-sm tracking-widest uppercase transition-colors duration-300\" data-kid=\"1-3-1-2-3-1-1-1\" data-name=\"contact label\">\n                                03 / Connect\n                            </div>\n                            <div data-kid=\"1-3-1-2-3-1-1-2\" data-name=\"contact title container\">\n                                <h3 class=\"display-font text-3xl font-bold uppercase tracking-tighter leading-none\" data-kid=\"1-3-1-2-3-1-1-2-1\" data-name=\"contact title\">\n                                    Contact\n                                </h3>\n                            </div>\n                        </div>\n                        <div class=\"absolute top-8 right-8 md:top-12 md:right-12 opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-white z-0\" data-kid=\"1-3-1-2-3-1-2\" data-name=\"email icon\">\n                            <svg class=\"w-6 h-6\" data-kid=\"1-3-1-2-3-1-2-1\" data-name=\"email icon path\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                <path d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                                </path>\n                            </svg>\n                        </div>\n                    </a>\n                </div>\n                <!-- Cell 4 -->\n                <div class=\"bento-wrapper h-full\" data-kid=\"1-3-1-2-4\" data-name=\"social links card\">\n                    <div class=\"h-full bg-white relative p-8 md:p-12 flex flex-col justify-between\" data-kid=\"1-3-1-2-4-1\" data-name=\"social links content wrapper\">\n                        <div class=\"text-[#111111] font-bold text-sm tracking-widest uppercase\" data-kid=\"1-3-1-2-4-1-1\" data-name=\"social links label\">\n                            04 / Social\n                        </div>\n                        <ul class=\"space-y-4 text-sm uppercase tracking-widest font-bold text-[#111111]\" data-kid=\"1-3-1-2-4-1-2\" data-name=\"social links list\">\n                            <li data-kid=\"1-3-1-2-4-1-2-1\" data-name=\"twitter link container\">\n                                <a class=\"flex items-center justify-between group hover:text-[#FE0000] transition-colors duration-300\" data-kid=\"1-3-1-2-4-1-2-1-1\" data-name=\"twitter link\" href=\"#\">\n                                    <span data-kid=\"1-3-1-2-4-1-2-1-1-1\" data-name=\"twitter text\">\n                                        Twitter\n                                    </span>\n                                    <svg class=\"w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300\" data-kid=\"1-3-1-2-4-1-2-1-1-2\" data-name=\"twitter arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M5 12h14M12 5l7 7-7 7\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                                        </path>\n                                    </svg>\n                                </a>\n                            </li>\n                            <li data-kid=\"1-3-1-2-4-1-2-2\" data-name=\"linkedin link container\">\n                                <a class=\"flex items-center justify-between group hover:text-[#FE0000] transition-colors duration-300\" data-kid=\"1-3-1-2-4-1-2-2-1\" data-name=\"linkedin link\" href=\"#\">\n                                    <span data-kid=\"1-3-1-2-4-1-2-2-1-1\" data-name=\"linkedin text\">\n                                        LinkedIn\n                                    </span>\n                                    <svg class=\"w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300\" data-kid=\"1-3-1-2-4-1-2-2-1-2\" data-name=\"linkedin arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M5 12h14M12 5l7 7-7 7\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                                        </path>\n                                    </svg>\n                                </a>\n                            </li>\n                            <li data-kid=\"1-3-1-2-4-1-2-3\" data-name=\"instagram link container\">\n                                <a class=\"flex items-center justify-between group hover:text-[#FE0000] transition-colors duration-300\" data-kid=\"1-3-1-2-4-1-2-3-1\" data-name=\"instagram link\" href=\"#\">\n                                    <span data-kid=\"1-3-1-2-4-1-2-3-1-1\" data-name=\"instagram text\">\n                                        Instagram\n                                    </span>\n                                    <svg class=\"w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300\" data-kid=\"1-3-1-2-4-1-2-3-1-2\" data-name=\"instagram arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M5 12h14M12 5l7 7-7 7\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                                        </path>\n                                    </svg>\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <footer class=\"py-8 px-6 md:px-12 lg:px-24 text-center text-xs font-bold uppercase tracking-widest text-gray-400 bg-white\" data-kid=\"1-4\" data-name=\"footer section\">\n        © 2024 S. Studio. All Rights Reserved.\n    </footer>\n</main>\n<link data-kid=\"2\" data-name=\"lenis scroll styles\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  const lenis = new Lenis({ autoRaf: true })\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n  \n  document.addEventListener(\"DOMContentLoaded\", () => {\n    \n    gsap.from(\"#hero-image\", {\n      autoAlpha: 0,\n      xPercent: 20,\n      duration: 1.2,\n      ease: \"power3.out\",\n      delay: 0.1\n    });\n\n    gsap.from(\".hero-text\", {\n      autoAlpha: 0,\n      y: 24,\n      duration: 0.8,\n      ease: \"power3.out\",\n      stagger: 0.1,\n      delay: 0.3\n    });\n\n    gsap.utils.toArray('.intro-text, .pull-quote').forEach(el => {\n      gsap.from(el, {\n        scrollTrigger: {\n          trigger: el,\n          start: \"top 85%\",\n        },\n        autoAlpha: 0,\n        y: 24,\n        duration: 0.8,\n        ease: \"power3.out\"\n      });\n    });\n\n    gsap.from(\".bento-wrapper\", {\n      scrollTrigger: {\n        trigger: \"#bento-section\",\n        start: \"top 80%\",\n      },\n      autoAlpha: 0,\n      y: 24,\n      duration: 0.6,\n      ease: \"power3.out\",\n      stagger: 0.1\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-09-07T12:37:14.469049+00:00",
      "modified": "2026-09-07T12:37:14.469049+00:00",
      "id": "var_f73f85d26b4a",
      "viewportScrollY": 0
    },
    "var_36e9e041b93f": {
      "type": "variant",
      "label": "Retro/Vaporwave",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;700&family=Space+Grotesk:wght@400;700&display=swap');\n\n  /* Base Typography */\n  .font-sans {\n    font-family: 'Fira Sans', sans-serif;\n  }\n  .font-grotesk {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n  .font-mono {\n    font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  }\n\n  /* Neon Effects */\n  .neon-sign {\n    -webkit-text-stroke: 2px #FF00FF;\n    color: transparent;\n    filter: drop-shadow(0 0 10px rgba(255, 0, 255, 0.8)) drop-shadow(0 0 20px rgba(255, 0, 255, 0.6));\n  }\n  \n  .neon-subtitle {\n    text-shadow: 0 0 6px rgba(0, 255, 255, 0.8), 0 0 12px rgba(0, 255, 255, 0.6), 0 0 24px rgba(0, 255, 255, 0.4);\n  }\n\n  @keyframes neon-flicker {\n    0%, 18%, 22%, 25%, 53%, 57%, 100% {\n      filter: drop-shadow(0 0 10px rgba(255, 0, 255, 0.8)) drop-shadow(0 0 20px rgba(255, 0, 255, 0.6));\n      opacity: 1;\n    }\n    20%, 24%, 55% {\n      filter: drop-shadow(0 0 2px rgba(255, 0, 255, 0.4));\n      opacity: 0.8;\n    }\n    54% {\n      filter: none;\n      opacity: 0.4;\n    }\n  }\n  \n  .animate-flicker {\n    animation: neon-flicker 5s infinite;\n  }\n\n  /* Blinking Cursor for Terminal */\n  @keyframes blink {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0; }\n  }\n  .animate-blink {\n    animation: blink 1s step-end infinite;\n  }\n</style>\n<div class=\"relative min-h-screen bg-[#16166B] text-white font-sans overflow-hidden selection:bg-[#FF00FF] selection:text-white\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Grid Paper Background Overlay -->\n    <div class=\"absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(255,0,255,0.15)_1px,transparent_1px),linear-gradient(90deg,rgba(255,0,255,0.15)_1px,transparent_1px)] bg-[size:40px_40px]\" data-kid=\"1-1\" data-name=\"grid paper background pattern\">\n    </div>\n    <!-- 3D Wireframe Background Image -->\n    <img alt=\"Wireframe 3D grid stretching to a vanishing point on a dark background. Logan Voss on Unsplash\" class=\"absolute top-0 left-0 w-full h-full object-cover opacity-[0.15] mix-blend-screen pointer-events-none\" data-kid=\"1-2\" data-name=\"wireframe background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1769120062349-9d97b2ca01f5?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxXaXJlZnJhbWUlMjAzRCUyMGdyaWQlMjBzdHJldGNoaW5nJTIwdG8lMjBhJTIwdmFuaXNoaW5nJTIwcG9pbnQlMjBvbiUyMGElMjBkYXJrJTIwYmFja2dyb3VuZHxlbnwwfHx8fDE3ODg3ODQ2MTh8MA&ixlib=rb-4.1.0&q=85&w=1920\"/>\n    <!-- Main Content Container -->\n    <div class=\"relative z-10 max-w-7xl mx-auto px-6 py-20 lg:py-32 flex flex-col items-center\" data-kid=\"1-3\" data-name=\"main content container\">\n        <!-- Hero Section -->\n        <header class=\"text-center mb-20 lg:mb-32\" data-kid=\"1-3-1\" data-name=\"hero section\">\n            <h1 class=\"text-7xl md:text-9xl font-bold font-grotesk tracking-widest uppercase neon-sign animate-flicker\" data-kid=\"1-3-1-1\" data-name=\"hero headline text\">\n                SYSTEM\n            </h1>\n            <h2 class=\"text-2xl md:text-4xl font-bold font-grotesk tracking-[0.3em] uppercase text-[#00FFFF] mt-6 neon-subtitle\" data-kid=\"1-3-1-2\" data-name=\"hero subtitle text\">\n                Online\n            </h2>\n        </header>\n        <!-- Content Sections Wrapper -->\n        <div class=\"w-full flex flex-col lg:flex-row gap-16 lg:gap-24 items-center lg:items-stretch justify-between\" data-kid=\"1-3-2\" data-name=\"content sections wrapper\">\n            <!-- Introduction / Stats: Terminal CLI -->\n            <section class=\"flex-1 w-full lg:max-w-xl flex flex-col\" data-kid=\"1-3-2-1\" data-name=\"terminal interface section\">\n                <div class=\"border-[1.5px] border-[#00FFFF] shadow-[0_0_12px_rgba(0,255,255,0.2),0_0_36px_rgba(0,255,255,0.06)] bg-[#05051F]/90 backdrop-blur-md rounded-lg overflow-hidden flex flex-col h-full font-mono min-h-[360px]\" data-kid=\"1-3-2-1-1\" data-name=\"terminal window container\">\n                    <!-- Window Chrome -->\n                    <div class=\"flex items-center px-4 py-3 bg-[#00FFFF]/10 border-b border-[#00FFFF]/30\" data-kid=\"1-3-2-1-1-1\" data-name=\"terminal window header\">\n                        <div class=\"flex gap-2 w-20\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"window control buttons container\">\n                            <div class=\"w-3.5 h-3.5 rounded-full bg-[#FF0055] shadow-[0_0_8px_rgba(255,0,85,0.6)]\" data-kid=\"1-3-2-1-1-1-1-1\" data-name=\"close button\">\n                            </div>\n                            <div class=\"w-3.5 h-3.5 rounded-full bg-[#EAB308] shadow-[0_0_8px_rgba(234,179,8,0.6)]\" data-kid=\"1-3-2-1-1-1-1-2\" data-name=\"minimize button\">\n                            </div>\n                            <div class=\"w-3.5 h-3.5 rounded-full bg-[#00FFFF] shadow-[0_0_8px_rgba(0,255,255,0.6)]\" data-kid=\"1-3-2-1-1-1-1-3\" data-name=\"maximize button\">\n                            </div>\n                        </div>\n                        <div class=\"flex-1 text-center text-xs md:text-sm text-[#00FFFF]/80 uppercase tracking-[0.2em] font-semibold\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"terminal title text\">\n                            guest@vapor: ~\n                        </div>\n                        <div class=\"w-20\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"spacer container\">\n                        </div>\n                    </div>\n                    <!-- Terminal Content -->\n                    <div class=\"p-6 text-[#00FFFF] text-sm md:text-base leading-loose flex-1 flex flex-col\" data-kid=\"1-3-2-1-1-2\" data-name=\"terminal text content\">\n                        <div class=\"mb-4\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"terminal command input\">\n                            <span class=\"text-[#FF00FF] font-bold\" data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"terminal prompt label\">\n                                guest@vapor:~$\n                            </span>\n                            <span class=\"typewriter-text\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2-1-2\" data-name=\"typewriter effect text\" data-reason=\"text character-by-character typed by script\" data-text=\"./init_profile.sh\">\n                            </span>\n                        </div>\n                        <div class=\"opacity-0 terminal-output transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"terminal output container\" data-reason=\"opacity changed from 0 to 1 by script\">\n                            <div class=\"text-[#00FFFF]/80\" data-kid=\"1-3-2-1-1-2-2-1\" data-name=\"boot sequence text\">\n                                > BOOT SEQUENCE INITIATED...\n                            </div>\n                            <div class=\"mt-2 text-white/90\" data-kid=\"1-3-2-1-1-2-2-2\" data-name=\"hello world intro text\">\n                                > Hello World. I build immersive digital experiences.\n                            </div>\n                            <div class=\"text-white/90\" data-kid=\"1-3-2-1-1-2-2-3\" data-name=\"job title text\">\n                                > Frontend Developer | UI/UX Designer\n                            </div>\n                            <div class=\"text-[#FF00FF] mt-2 font-semibold\" data-kid=\"1-3-2-1-1-2-2-4\" data-name=\"passion statement text\">\n                                > PASSIONATE ABOUT RETRO AESTHETICS & CLEAN CODE.\n                            </div>\n                            <div class=\"text-white/90\" data-kid=\"1-3-2-1-1-2-2-5\" data-name=\"status update text\">\n                                > Current Status: 100% OPERATIONAL\n                            </div>\n                        </div>\n                        <div class=\"mt-auto pt-6 opacity-0 terminal-prompt transition-opacity duration-300\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2-3\" data-name=\"terminal input prompt line\" data-reason=\"opacity changed from 0 to 1 by script\">\n                            <span class=\"text-[#FF00FF] font-bold\" data-kid=\"1-3-2-1-1-2-3-1\" data-name=\"prompt command label\">\n                                guest@vapor:~$\n                            </span>\n                            <span class=\"inline-block w-2.5 h-[1em] bg-[#00FFFF] align-middle animate-blink ml-1\" data-kid=\"1-3-2-1-1-2-3-2\" data-name=\"blinking cursor\">\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Quick Links: Tilted Grid -->\n            <section class=\"flex-1 w-full lg:max-w-xl flex items-center justify-center\" data-kid=\"1-3-2-2\" data-name=\"quick links section\">\n                <!-- Tilted Envelope -->\n                <div class=\"grid grid-cols-2 gap-6 p-4 md:p-8 -rotate-6 transform origin-center w-full max-w-lg\" data-kid=\"1-3-2-2-1\" data-name=\"tilted links grid container\">\n                    <!-- Card 1 -->\n                    <a class=\"block bg-[#05051F] border-2 border-[#FF00FF] shadow-[4px_4px_0_#FF00FF,8px_8px_0_#00FFFF] p-6 lg:p-8 rotate-6 hover:-translate-y-2 hover:scale-105 hover:shadow-[6px_6px_0_#FF00FF,12px_12px_0_#00FFFF] transition-all duration-300 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] group\" data-kid=\"1-3-2-2-1-1\" data-name=\"portfolio card link\" href=\"#\">\n                        <div class=\"flex flex-col items-center gap-4\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"portfolio card content\">\n                            <img alt=\"Portfolio icon\" class=\"w-12 h-12 group-hover:scale-110 group-hover:-translate-y-1 transition-transform duration-300 drop-shadow-[0_0_8px_rgba(255,0,255,0.5)]\" data-kid=\"1-3-2-2-1-1-1-1\" data-name=\"floppy disk icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/floppy-disk.svg\"/>\n                            <span class=\"text-[#FF00FF] font-bold font-grotesk uppercase tracking-widest text-sm lg:text-base text-center group-hover:text-white transition-colors\" data-kid=\"1-3-2-2-1-1-1-2\" data-name=\"portfolio link label\">\n                                Portfolio.exe\n                            </span>\n                        </div>\n                    </a>\n                    <!-- Card 2 -->\n                    <a class=\"block bg-[#05051F] border-2 border-[#00FFFF] shadow-[4px_4px_0_#00FFFF,8px_8px_0_#FF00FF] p-6 lg:p-8 rotate-6 hover:-translate-y-2 hover:scale-105 hover:shadow-[6px_6px_0_#00FFFF,12px_12px_0_#FF00FF] transition-all duration-300 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] group mt-8\" data-kid=\"1-3-2-2-1-2\" data-name=\"about page card link\" href=\"#\">\n                        <div class=\"flex flex-col items-center gap-4\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"about card content\">\n                            <img alt=\"About icon\" class=\"w-12 h-12 group-hover:scale-110 group-hover:-translate-y-1 transition-transform duration-300 drop-shadow-[0_0_8px_rgba(0,255,255,0.5)]\" data-kid=\"1-3-2-2-1-2-1-1\" data-name=\"computer disk icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/computer-disk.svg\"/>\n                            <span class=\"text-[#00FFFF] font-bold font-grotesk uppercase tracking-widest text-sm lg:text-base text-center group-hover:text-white transition-colors\" data-kid=\"1-3-2-2-1-2-1-2\" data-name=\"about link label\">\n                                About.sys\n                            </span>\n                        </div>\n                    </a>\n                    <!-- Card 3 -->\n                    <a class=\"block bg-[#05051F] border-2 border-[#EAB308] shadow-[4px_4px_0_#EAB308,8px_8px_0_#FF00FF,12px_12px_0_#00FFFF] p-6 lg:p-8 rotate-6 hover:-translate-y-2 hover:scale-105 hover:shadow-[6px_6px_0_#EAB308,12px_12px_0_#FF00FF,18px_18px_0_#00FFFF] transition-all duration-300 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] group col-span-2 mt-4\" data-kid=\"1-3-2-2-1-3\" data-name=\"contact page card link\" href=\"#\">\n                        <div class=\"flex flex-col items-center gap-4\" data-kid=\"1-3-2-2-1-3-1\" data-name=\"contact card content\">\n                            <img alt=\"Contact icon\" class=\"w-14 h-14 group-hover:scale-110 group-hover:-translate-y-1 transition-transform duration-300 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]\" data-kid=\"1-3-2-2-1-3-1-1\" data-name=\"videocassette icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/videocassette.svg\"/>\n                            <span class=\"text-yellow-400 font-bold font-grotesk uppercase tracking-widest text-sm lg:text-base text-center group-hover:text-white transition-colors\" data-kid=\"1-3-2-2-1-3-1-2\" data-name=\"contact link label\">\n                                Contact.bat\n                            </span>\n                        </div>\n                    </a>\n                </div>\n            </section>\n        </div>\n    </div>\n</div>\n<script>\n    // Simple Typewriter Effect for Terminal\n  document.addEventListener('DOMContentLoaded', () => {\n    const typewriters = document.querySelectorAll('.typewriter-text');\n    \n    typewriters.forEach(el => {\n      const text = el.getAttribute('data-text');\n      if (!text) return;\n      \n      el.innerHTML = '';\n      let i = 0;\n      \n      // Delay before typing starts\n      setTimeout(() => {\n        const typeInterval = setInterval(() => {\n          if (i < text.length) {\n            el.innerHTML += text.charAt(i);\n            i++;\n          } else {\n            clearInterval(typeInterval);\n            \n            // Show terminal output after typing finishes\n            setTimeout(() => {\n              const terminalBody = el.closest('.p-6');\n              if (terminalBody) {\n                const output = terminalBody.querySelector('.terminal-output');\n                if(output) output.classList.remove('opacity-0');\n                \n                // Show prompt line slightly after output\n                setTimeout(() => {\n                  const prompt = terminalBody.querySelector('.terminal-prompt');\n                  if(prompt) prompt.classList.remove('opacity-0');\n                }, 600);\n              }\n            }, 400);\n          }\n        }, 60); // typing speed (ms per character)\n      }, 800); // initial delay\n    });\n  });\n</script>\n",
