    "var_0f1dc2ed0f2a": {
      "type": "variant",
      "label": "Swiss - Projects",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 16560,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<section class=\"bg-[var(--bg-primary)] text-[var(--text-primary)] pt-32 pb-24 font-sans font-[family:var(--font-main)] selection:bg-[var(--text-primary)] selection:text-[var(--bg-primary)] min-h-screen\" data-kid=\"1\" data-name=\"portfolio section container\">\n    <div class=\"px-6 md:px-12 lg:px-24 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-8\" data-kid=\"1-1\" data-name=\"header and description wrapper\">\n        <div data-kid=\"1-1-1\" data-name=\"header text group\">\n            <p class=\"uppercase tracking-widest text-[var(--text-muted)] font-medium mb-4 text-sm flex items-center gap-4\" data-kid=\"1-1-1-1\" data-name=\"portfolio label group\">\n                <span class=\"w-12 h-px bg-[var(--border-color)]\" data-kid=\"1-1-1-1-1\" data-name=\"decorative horizontal rule\">\n                </span>\n                Portfolio\n            </p>\n            <h2 class=\"text-7xl md:text-[8rem] font-black tracking-tighter uppercase leading-[0.9]\" data-kid=\"1-1-1-2\" data-name=\"section main title\">\n                Selected\n                <br data-kid=\"1-1-1-2-1\" data-name=\"title line break\"/>\n                Works.\n            </h2>\n        </div>\n        <p class=\"text-lg md:text-xl text-[var(--text-secondary)] max-w-md font-light leading-relaxed mb-4\" data-kid=\"1-1-2\" data-name=\"section description paragraph\">\n            A showcase of recent digital products, brand identities, and structural interfaces engineered with precision.\n        </p>\n    </div>\n    <div class=\"w-full border-t border-[var(--border-color)] grid grid-cols-1 md:grid-cols-12\" data-kid=\"1-2\" data-name=\"projects grid container\">\n        <!-- Project 01 -->\n        <article class=\"md:col-span-7 border-b md:border-r border-[var(--border-color)] p-8 md:p-12 lg:p-16 flex flex-col group hover:bg-[var(--bg-secondary)] transition-colors duration-500\" data-kid=\"1-2-1\" data-name=\"project card one\">\n            <div class=\"flex justify-between items-start mb-16\" data-kid=\"1-2-1-1\" data-name=\"project one header area\">\n                <span class=\"text-7xl md:text-9xl font-black text-[var(--text-muted)] opacity-40 tracking-tighter leading-none\" data-kid=\"1-2-1-1-1\" data-name=\"project number indicator\">\n                    01\n                </span>\n                <div class=\"flex flex-wrap gap-2 justify-end\" data-kid=\"1-2-1-1-2\" data-name=\"project one tags container\">\n                    <span class=\"px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-widest border border-[var(--border-color)] rounded-full text-[var(--text-secondary)] bg-[var(--bg-primary)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"tag web design\">\n                        Web Design\n                    </span>\n                    <span class=\"px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-widest border border-[var(--border-color)] rounded-full text-[var(--text-secondary)] bg-[var(--bg-primary)]\" data-kid=\"1-2-1-1-2-2\" data-name=\"tag development\">\n                        Development\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-auto\" data-kid=\"1-2-1-2\" data-name=\"project one content area\">\n                <div class=\"aspect-[4/3] w-full bg-[var(--bg-card)] mb-10 overflow-hidden relative border border-[var(--border-color)] group-hover:shadow-[var(--shadow-card)] transition-all duration-500\" data-kid=\"1-2-1-2-1\" data-name=\"project one image wrapper\">\n                    <img alt=\"Project preview\" class=\"w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105\" data-kid=\"1-2-1-2-1-1\" data-name=\"project one image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1551397967-8b3b73256395?auto=format&fit=crop&w=1200&q=80\"/>\n                </div>\n                <h3 class=\"text-5xl md:text-7xl font-black uppercase tracking-tighter mb-6 leading-[0.9]\" data-kid=\"1-2-1-2-2\" data-name=\"project one title\">\n                    Fintech\n                    <br data-kid=\"1-2-1-2-2-1\" data-name=\"project one title line break\"/>\n                    Dashboard\n                </h3>\n                <p class=\"text-[var(--text-secondary)] mb-10 text-lg font-light max-w-lg leading-relaxed\" data-kid=\"1-2-1-2-3\" data-name=\"project one description\">\n                    Comprehensive institutional trading interface designed for absolute clarity, speed, and split-second decision making.\n                </p>\n                <button class=\"btn btn-outline text-xs uppercase tracking-widest font-bold\" data-kid=\"1-2-1-2-4\" data-name=\"project one view project button\">\n                    View Project →\n                </button>\n            </div>\n        </article>\n        <!-- Project 02 -->\n        <article class=\"md:col-span-5 border-b border-[var(--border-color)] p-8 md:p-12 lg:p-16 flex flex-col group hover:bg-[var(--bg-secondary)] transition-colors duration-500\" data-kid=\"1-2-2\" data-name=\"project card two\">\n            <div class=\"flex justify-between items-start mb-16\" data-kid=\"1-2-2-1\" data-name=\"project two header area\">\n                <span class=\"text-7xl md:text-9xl font-black text-[var(--text-muted)] opacity-40 tracking-tighter leading-none\" data-kid=\"1-2-2-1-1\" data-name=\"project number indicator\">\n                    02\n                </span>\n                <div class=\"flex flex-wrap gap-2 justify-end\" data-kid=\"1-2-2-1-2\" data-name=\"project two tags container\">\n                    <span class=\"px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-widest border border-[var(--border-color)] rounded-full text-[var(--text-secondary)] bg-[var(--bg-primary)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"tag branding\">\n                        Branding\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-auto\" data-kid=\"1-2-2-2\" data-name=\"project two content area\">\n                <div class=\"aspect-[3/4] w-full bg-[var(--bg-card)] mb-10 overflow-hidden relative border border-[var(--border-color)] group-hover:shadow-[var(--shadow-card)] transition-all duration-500\" data-kid=\"1-2-2-2-1\" data-name=\"project two image wrapper\">\n                    <img alt=\"Project preview\" class=\"w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105\" data-kid=\"1-2-2-2-1-1\" data-name=\"project two image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1572890016824-4e316f5388f3?auto=format&fit=crop&w=1000&q=80\"/>\n                </div>\n                <h3 class=\"text-4xl md:text-5xl font-black uppercase tracking-tighter mb-6 leading-[0.9]\" data-kid=\"1-2-2-2-2\" data-name=\"project two title\">\n                    Nexus\n                    <br data-kid=\"1-2-2-2-2-1\" data-name=\"project two title line break\"/>\n                    Identity\n                </h3>\n                <p class=\"text-[var(--text-secondary)] mb-10 text-lg font-light max-w-sm leading-relaxed\" data-kid=\"1-2-2-2-3\" data-name=\"project two description\">\n                    A stark, brutalist rebranding for an architectural firm specializing in raw concrete structures and brutal aesthetics.\n                </p>\n                <button class=\"btn btn-outline text-xs uppercase tracking-widest font-bold\" data-kid=\"1-2-2-2-4\" data-name=\"project two view project button\">\n                    View Project →\n                </button>\n            </div>\n        </article>\n        <!-- Project 03 -->\n        <article class=\"md:col-span-5 border-b md:border-r border-[var(--border-color)] p-8 md:p-12 lg:p-16 flex flex-col group hover:bg-[var(--bg-secondary)] transition-colors duration-500\" data-kid=\"1-2-3\" data-name=\"project card three\">\n            <div class=\"flex justify-between items-start mb-16\" data-kid=\"1-2-3-1\" data-name=\"project three header area\">\n                <span class=\"text-7xl md:text-9xl font-black text-[var(--text-muted)] opacity-40 tracking-tighter leading-none\" data-kid=\"1-2-3-1-1\" data-name=\"project number indicator\">\n                    03\n                </span>\n                <div class=\"flex flex-wrap gap-2 justify-end\" data-kid=\"1-2-3-1-2\" data-name=\"project three tags container\">\n                    <span class=\"px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-widest border border-[var(--border-color)] rounded-full text-[var(--text-secondary)] bg-[var(--bg-primary)]\" data-kid=\"1-2-3-1-2-1\" data-name=\"tag e-commerce\">\n                        E-Commerce\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-auto\" data-kid=\"1-2-3-2\" data-name=\"project three content area\">\n                <div class=\"aspect-[4/5] w-full bg-[var(--bg-card)] mb-10 overflow-hidden relative border border-[var(--border-color)] group-hover:shadow-[var(--shadow-card)] transition-all duration-500\" data-kid=\"1-2-3-2-1\" data-name=\"project three image wrapper\">\n                    <img alt=\"Project preview\" class=\"w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105\" data-kid=\"1-2-3-2-1-1\" data-name=\"project three image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1554034483-04fda0d3507b?auto=format&fit=crop&w=1000&q=80\"/>\n                </div>\n                <h3 class=\"text-4xl md:text-6xl font-black uppercase tracking-tighter mb-6 leading-[0.9]\" data-kid=\"1-2-3-2-2\" data-name=\"project three title\">\n                    Aura\n                    <br data-kid=\"1-2-3-2-2-1\" data-name=\"project three title line break\"/>\n                    Store\n                </h3>\n                <p class=\"text-[var(--text-secondary)] mb-10 text-lg font-light max-w-sm leading-relaxed\" data-kid=\"1-2-3-2-3\" data-name=\"project three description\">\n                    Minimalist digital storefront emphasizing product form, bold typography, and frictionless checkout flows.\n                </p>\n                <button class=\"btn btn-outline text-xs uppercase tracking-widest font-bold\" data-kid=\"1-2-3-2-4\" data-name=\"project three view project button\">\n                    View Project →\n                </button>\n            </div>\n        </article>\n        <!-- Project 04 -->\n        <article class=\"md:col-span-7 border-b border-[var(--border-color)] p-8 md:p-12 lg:p-16 flex flex-col group hover:bg-[var(--bg-secondary)] transition-colors duration-500\" data-kid=\"1-2-4\" data-name=\"project card four\">\n            <div class=\"flex justify-between items-start mb-16\" data-kid=\"1-2-4-1\" data-name=\"project four header area\">\n                <span class=\"text-7xl md:text-9xl font-black text-[var(--text-muted)] opacity-40 tracking-tighter leading-none\" data-kid=\"1-2-4-1-1\" data-name=\"project number indicator\">\n                    04\n                </span>\n                <div class=\"flex flex-wrap gap-2 justify-end\" data-kid=\"1-2-4-1-2\" data-name=\"project four tags container\">\n                    <span class=\"px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-widest border border-[var(--border-color)] rounded-full text-[var(--text-secondary)] bg-[var(--bg-primary)]\" data-kid=\"1-2-4-1-2-1\" data-name=\"tag app design\">\n                        App Design\n                    </span>\n                    <span class=\"px-4 py-1.5 text-[0.7rem] font-bold uppercase tracking-widest border border-[var(--border-color)] rounded-full text-[var(--text-secondary)] bg-[var(--bg-primary)]\" data-kid=\"1-2-4-1-2-2\" data-name=\"tag strategy\">\n                        Strategy\n                    </span>\n                </div>\