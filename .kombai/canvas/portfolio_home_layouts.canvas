        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Outfit', sans-serif;\n    color: #1f2937;\n    margin: 0;\n    padding: 0;\n    overflow-x: hidden;\n  }\n\n  /* #gradient-mesh & #anime-ambient-gradient equivalent via CSS for ultra-smoothness */\n  .aurora-bg {\n    position: fixed;\n    top: -50%;\n    left: -50%;\n    width: 200%;\n    height: 200%;\n    z-index: -1;\n    background: linear-gradient(\n      45deg,\n      #F8F8FF 10%,\n      #E0B0FF 30%,\n      #89CFF0 60%,\n      #FF91AF 80%,\n      #F8F8FF 100%\n    );\n    background-size: 400% 400%;\n    animation: drift 25s ease-in-out infinite alternate;\n    opacity: 0.6;\n    filter: blur(40px); /* Softens the gradient bands */\n  }\n\n  @keyframes drift {\n    0% { background-position: 0% 0%; transform: rotate(0deg) scale(1); }\n    50% { background-position: 100% 100%; transform: rotate(2deg) scale(1.05); }\n    100% { background-position: 0% 50%; transform: rotate(-2deg) scale(1); }\n  }\n\n  /* #frosted-panel & #glassmorphism base */\n  .glass {\n    background: rgba(255, 255, 255, 0.4);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.6);\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.05);\n  }\n  \n  .glass-light {\n    background: rgba(255, 255, 255, 0.25);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.4);\n    box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.03);\n  }\n\n  /* Floating Island Animation */\n  @keyframes float {\n    0% { transform: translateY(0px); }\n    50% { transform: translateY(-20px); }\n    100% { transform: translateY(0px); }\n  }\n  .island-1 { animation: float 6s ease-in-out infinite; }\n  .island-2 { animation: float 7s ease-in-out infinite -2s; }\n  .island-3 { animation: float 6.5s ease-in-out infinite -4s; }\n\n  /* Utilities */\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n</style>\n<!-- Top Progress Bar -->\n<div class=\"fixed top-0 left-0 h-1.5 bg-gradient-to-r from-[#89CFF0] via-[#E0B0FF] to-[#FF91AF] z-50 origin-left shadow-[0_0_10px_rgba(224,176,255,0.8)] w-full\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"top scroll progress bar\" data-reason=\"scaleX property modified by scroll position\" id=\"progress-bar\" style=\"transform: scaleX(0);\">\n</div>\n<!-- Ambient Background -->\n<div class=\"fixed inset-0 bg-[#F8F8FF] -z-20\" data-kid=\"2\" data-name=\"background color layer\">\n</div>\n<div class=\"aurora-bg\" data-kid=\"3\" data-name=\"ambient aurora background\">\n</div>\n<!-- Decorative foreground blur elements -->\n<div class=\"fixed top-[10%] left-[10%] w-[40vw] h-[40vw] rounded-full bg-[#E0B0FF]/20 blur-[120px] pointer-events-none -z-10\" data-kid=\"4\" data-name=\"top-left decorative foreground blur\">\n</div>\n<div class=\"fixed bottom-[10%] right-[10%] w-[50vw] h-[50vw] rounded-full bg-[#89CFF0]/20 blur-[120px] pointer-events-none -z-10\" data-kid=\"5\" data-name=\"bottom-right decorative foreground blur\">\n</div>\n<main class=\"relative z-10 flex flex-col items-center w-full min-h-screen px-6 pt-32 pb-40 overflow-hidden\" data-kid=\"6\" data-name=\"main content layout container\">\n    <!-- Hero Section (#frosted-panel) -->\n    <section class=\"w-full max-w-5xl mb-48 flex justify-center\" data-kid=\"6-1\" data-name=\"hero section container\">\n        <div class=\"glass relative w-full rounded-[2.5rem] p-10 md:p-20 flex flex-col items-center text-center overflow-hidden\" data-kid=\"6-1-1\" data-name=\"hero section frosted glass panel\">\n            <!-- Inner mesh subtle overlay -->\n            <div class=\"absolute inset-0 bg-white/10 mix-blend-overlay pointer-events-none\" data-kid=\"6-1-1-1\" data-name=\"inner mesh subtle overlay\">\n            </div>\n            <div class=\"relative z-10 flex flex-col items-center\" data-kid=\"6-1-1-2\" data-name=\"hero content wrapper\">\n                <div class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/40 border border-white/60 text-sm font-medium mb-8 backdrop-blur-md shadow-sm\" data-kid=\"6-1-1-2-1\" data-name=\"badge container\">\n                    <i class=\"ti ti-sparkles text-[#FF91AF] text-lg\" data-kid=\"6-1-1-2-1-1\" data-name=\"sparkles icon\">\n                    </i>\n                    <span class=\"text-gray-700 tracking-wide\" data-kid=\"6-1-1-2-1-2\" data-name=\"badge text\">\n                        Designing Dreamscapes\n                    </span>\n                </div>\n                <h1 class=\"text-6xl md:text-8xl font-light tracking-tight text-gray-900 mb-8 leading-[1.1]\" data-kid=\"6-1-1-2-2\" data-name=\"hero headline text\">\n                    Weaving light,\n                    <br data-kid=\"6-1-1-2-2-1\" data-name=\"headline line break\"/>\n                    shape, & code.\n                </h1>\n                <p class=\"text-xl md:text-2xl text-gray-700 max-w-2xl mx-auto mb-12 font-light leading-relaxed\" data-kid=\"6-1-1-2-3\" data-name=\"hero subheadline description text\">\n                    I craft ethereal digital experiences where interaction feels like magic. Specializing in spatial UI and poetic motion design.\n                </p>\n                <button class=\"hero-btn group relative inline-flex items-center justify-center px-10 py-5 text-lg font-medium text-white bg-gray-900/90 backdrop-blur-sm border border-gray-700 rounded-full overflow-hidden transition-all duration-300 hover:bg-gray-900 hover:shadow-[0_12px_40px_rgba(224,176,255,0.4)]\" data-kid=\"6-1-1-2-4\" data-name=\"call-to-action button\">\n                    <span class=\"relative z-10 flex items-center gap-3\" data-kid=\"6-1-1-2-4-1\" data-name=\"button label container\">\n                        Explore the Canvas\n                        <i class=\"ti ti-compass text-xl transition-transform duration-300 group-hover:rotate-45\" data-kid=\"6-1-1-2-4-1-1\" data-name=\"compass icon\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- Introduction / Vision (#floating-islands) -->\n    <section class=\"w-full max-w-6xl mb-48 flex flex-col items-center relative\" data-kid=\"6-2\" data-name=\"philosophy section\">\n        <div class=\"text-center mb-16 relative z-20\" data-kid=\"6-2-1\" data-name=\"section header container\">\n            <h2 class=\"text-4xl md:text-5xl font-light mb-6 text-gray-900\" data-kid=\"6-2-1-1\" data-name=\"section title text\">\n                The Philosophy\n            </h2>\n            <p class=\"text-gray-600 font-light text-xl max-w-2xl mx-auto\" data-kid=\"6-2-1-2\" data-name=\"section description text\">\n                Blending the boundaries between software and art. Every pixel is intentional, every motion tells a story.\n            </p>\n        </div>\n        <div class=\"relative w-full h-[400px] max-w-4xl mx-auto\" data-kid=\"6-2-2\" data-name=\"floating islands display container\">\n            <!-- Island 1 -->\n            <div class=\"island-1 absolute top-10 left-[5%] md:left-[10%] w-64 p-6 rounded-full glass-light flex items-center justify-center text-center shadow-lg hover:bg-white/40 transition-colors duration-300\" data-kid=\"6-2-2-1\" data-name=\"fluid interaction floating island\">\n                <span class=\"text-xl text-gray-800 font-medium tracking-wide\" data-kid=\"6-2-2-1-1\" data-name=\"fluid interaction label text\">\n                    Fluid Interaction\n                </span>\n            </div>\n            <!-- Island 2 -->\n            <div class=\"island-2 absolute top-40 right-[2%] md:right-[5%] w-72 md:w-80 p-8 rounded-[3rem] glass flex flex-col items-center justify-center text-center shadow-xl hover:bg-white/50 transition-colors duration-300 z-10\" data-kid=\"6-2-2-2\" data-name=\"ambient interfaces floating island\">\n                <div class=\"w-12 h-12 rounded-full bg-gradient-to-br from-[#E0B0FF] to-[#89CFF0] mb-4 opacity-70\" data-kid=\"6-2-2-2-1\" data-name=\"ambient interfaces decorative graphic\">\n                </div>\n                <span class=\"text-2xl text-gray-900 font-medium tracking-wide\" data-kid=\"6-2-2-2-2\" data-name=\"ambient interfaces label text\">\n                    Ambient Interfaces\n                </span>\n            </div>\n            <!-- Island 3 -->\n            <div class=\"island-3 absolute bottom-0 left-[20%] md:left-[35%] w-56 p-5 rounded-full glass-light flex items-center justify-center text-center shadow-md hover:bg-white/40 transition-colors duration-300\" data-kid=\"6-2-2-3\" data-name=\"spatial depth floating island\">\n                <span class=\"text-lg text-gray-700 font-medium tracking-wide\" data-kid=\"6-2-2-3-1\" data-name=\"spatial depth label text\">\n                    Spatial Depth\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- Quick Links (#glass-grid) -->\n    <section class=\"w-full max-w-6xl\" data-kid=\"6-3\" data-name=\"curated spaces section\">\n        <div class=\"text-center mb-20\" data-kid=\"6-3-1\" data-name=\"section header container\">\n            <h2 class=\"text-4xl md:text-5xl font-light text-gray-900\" data-kid=\"6-3-1-1\" data-name=\"section title text\">\n                Curated Spaces\n            </h2>\n        </div>\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10\" data-kid=\"6-3-2\" data-name=\"quick links grid container\">\n            <!-- Card 1 -->\n            <a class=\"quick-link group relative h-80 rounded-[2.5rem] glass-light p-8 flex flex-col justify-end overflow-hidden cursor-pointer isolate\" data-dynamic=\"true\" data-kid=\"6-3-2-1\" data-name=\"selected works card\" data-reason=\"boxShadow and scale properties manipulated by hover interaction\" href=\"#\">\n                <div class=\"absolute inset-0 -z-10 bg-white/10 transition-opacity duration-300 group-hover:opacity-0\" data-kid=\"6-3-2-1-1\" data-name=\"card background overlay\">\n                </div>\n                <img alt=\"Selected Works Background\" class=\"absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-multiply -z-20 transition-transform duration-700 ease-out group-hover:scale-110\" data-kid=\"6-3-2-1-2\" data-name=\"card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1668853853439-923e013afff1?auto=format&w=800&fit=crop&q=80\"/>\n                <div class=\"relative z-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 ease-out\" data-kid=\"6-3-2-1-3\" data-name=\"card content wrapper\">\n                    <div class=\"w-12 h-12 rounded-full bg-white/40 backdrop-blur-md flex items-center justify-center mb-6 text-gray-800 border border-white/50\" data-kid=\"6-3-2-1-3-1\" data-name=\"card icon container\">\n                        <i class=\"ti ti-diamonds text-2xl\" data-kid=\"6-3-2-1-3-1-1\" data-name=\"diamonds icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"text-3xl font-medium text-gray-900 mb-3\" data-kid=\"6-3-2-1-3-2\" data-name=\"card title text\">\n                        Selected Works\n                    </h3>\n                    <p class=\"text-gray-700 text-base font-light opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100\" data-kid=\"6-3-2-1-3-3\" data-name=\"card description text\">\n                        A gallery of shipped products and interactive experiments.\n                    </p>\n                </div>\n            </a>\n            <!-- Card 2 -->\n            <a class=\"quick-link group relative h-80 rounded-[2.5rem] glass-light p-8 flex flex-col justify-end overflow-hidden cursor-pointer isolate\" data-dynamic=\"true\" data-kid=\"6-3-2-2\" data-name=\"the lab card\" data-reason=\"boxShadow and scale properties manipulated by hover interaction\" href=\"#\">\n                <div class=\"absolute inset-0 -z-10 bg-white/10 transition-opacity duration-300 group-hover:opacity-0\" data-kid=\"6-3-2-2-1\" data-name=\"card background overlay\">\n                </div>\n                <img alt=\"The Lab Background\" class=\"absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-multiply -z-20 transition-transform duration-700 ease-out group-hover:scale-110\" data-kid=\"6-3-2-2-2\" data-name=\"card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1618397746666-63405ce5d015?auto=format&w=800&fit=crop&q=80\"/>\n                <div class=\"relative z-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 ease-out\" data-kid=\"6-3-2-2-3\" data-name=\"card content wrapper\">\n                    <div class=\"w-12 h-12 rounded-full bg-white/40 backdrop-blur-md flex items-center justify-center mb-6 text-gray-800 border border-white/50\" data-kid=\"6-3-2-2-3-1\" data-name=\"card icon container\">\n                        <i class=\"ti ti-cube-spark text-2xl\" data-kid=\"6-3-2-2-3-1-1\" data-name=\"cube sparkles icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"text-3xl font-medium text-gray-900 mb-3\" data-kid=\"6-3-2-2-3-2\" data-name=\"card title text\">\n                        The Lab\n                    </h3>\n                    <p class=\"text-gray-700 text-base font-light opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100\" data-kid=\"6-3-2-2-3-3\" data-name=\"card description text\">\n                        Unpolished concepts, shaders, and creative coding.\n                    </p>\n                </div>\n            </a>\n            <!-- Card 3 -->\n            <a class=\"quick-link group relative h-80 rounded-[2.5rem] glass-light p-8 flex flex-col justify-end overflow-hidden cursor-pointer isolate\" data-dynamic=\"true\" data-kid=\"6-3-2-3\" data-name=\"journal card\" data-reason=\"boxShadow and scale properties manipulated by hover interaction\" href=\"#\">\n                <div class=\"absolute inset-0 -z-10 bg-white/10 transition-opacity duration-300 group-hover:opacity-0\" data-kid=\"6-3-2-3-1\" data-name=\"card background overlay\">\n                </div>\n                <img alt=\"Journal Background\" class=\"absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-multiply -z-20 transition-transform duration-700 ease-out group-hover:scale-110\" data-kid=\"6-3-2-3-2\" data-name=\"card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7130555/pexels-photo-7130555.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                <div class=\"relative z-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 ease-out\" data-kid=\"6-3-2-3-3\" data-name=\"card content wrapper\">\n                    <div class=\"w-12 h-12 rounded-full bg-white/40 backdrop-blur-md flex items-center justify-center mb-6 text-gray-800 border border-white/50\" data-kid=\"6-3-2-3-3-1\" data-name=\"card icon container\">\n                        <i class=\"ti ti-brightness-2 text-2xl\" data-kid=\"6-3-2-3-3-1-1\" data-name=\"brightness icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"text-3xl font-medium text-gray-900 mb-3\" data-kid=\"6-3-2-3-3-2\" data-name=\"card title text\">\n                        Journal\n                    </h3>\n                    <p class=\"text-gray-700 text-base font-light opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100\" data-kid=\"6-3-2-3-3-3\" data-name=\"card description text\">\n                        Thoughts on design systems and digital craft.\n                    </p>\n                </div>\n            </a>\n        </div>\n    </section>\n</main>\n<script type=\"module\">\n    import { animate, scroll, hover } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import { animate as animeAnimate } from 'https://esm.sh/animejs@4';\n\n  // #motion-progress-bar: Scroll linked progress\n  scroll(animate(\"#progress-bar\", { scaleX: [0, 1] }, { ease: \"linear\" }));\n\n  // #motion-hover-glow & #motion-spring-pop on quick links\n  hover(\".quick-link\", (element) => {\n    // Glow and slight scale up\n    animate(element, \n      { scale: 1.02, boxShadow: '0 20px 50px -10px rgba(224, 176, 255, 0.6), 0 8px 32px 0 rgba(0, 0, 0, 0.1)' },\n      { duration: 0.4, ease: \"easeOut\" }\n    );\n    \n    return () => {\n      // Return to base state\n      animate(element, \n        { scale: 1, boxShadow: '0 4px 16px 0 rgba(0, 0, 0, 0.03)' },\n        { type: \"spring\", visualDuration: 0.6, bounce: 0.4 }\n      );\n    };\n  });\n</script>\n",
