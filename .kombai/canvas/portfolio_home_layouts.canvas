    "var_4b0a93937d76": {
      "type": "variant",
      "label": "Swiss - Contacts",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 11040,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<section class=\"w-full bg-[var(--bg-primary)] text-[var(--text-primary)] py-32 px-6 md:px-16\" data-kid=\"1\" data-name=\"contact section container\" style=\"font-family: var(--font-main)\">\n    <div class=\"max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-8\" data-kid=\"1-1\" data-name=\"contact section grid layout\">\n        <!-- Left: Typography & Info -->\n        <div class=\"lg:col-span-5 flex flex-col justify-between\" data-kid=\"1-1-1\" data-name=\"information and contact details panel\">\n            <div data-kid=\"1-1-1-1\" data-name=\"introductory text container\">\n                <h2 class=\"text-7xl lg:text-9xl font-black uppercase tracking-tighter leading-[0.9] mb-6\" data-kid=\"1-1-1-1-1\" data-name=\"hero headline\">\n                    Let's\n                    <br data-kid=\"1-1-1-1-1-1\" data-name=\"line break\"/>\n                    Talk.\n                </h2>\n                <p class=\"text-xl md:text-2xl text-[var(--text-secondary)] max-w-md font-medium leading-snug\" data-kid=\"1-1-1-1-2\" data-name=\"introductory description paragraph\">\n                    Have a project in mind or just want to say hi? I'm currently available for freelance opportunities.\n                </p>\n            </div>\n            <div class=\"mt-20 lg:mt-0\" data-kid=\"1-1-1-2\" data-name=\"contact links container\">\n                <h3 class=\"text-sm font-bold uppercase tracking-widest text-[var(--text-muted)] mb-3\" data-kid=\"1-1-1-2-1\" data-name=\"email section header\">\n                    Email\n                </h3>\n                <a class=\"text-2xl md:text-4xl font-bold border-b-2 border-transparent hover:border-[var(--text-primary)] transition-colors duration-300 pb-1\" data-kid=\"1-1-1-2-2\" data-name=\"email address link\" href=\"mailto:hello@example.com\">\n                    hello@example.com\n                </a>\n                <h3 class=\"text-sm font-bold uppercase tracking-widest text-[var(--text-muted)] mb-3 mt-12\" data-kid=\"1-1-1-2-3\" data-name=\"socials section header\">\n                    Socials\n                </h3>\n                <div class=\"flex gap-8 text-lg font-bold\" data-kid=\"1-1-1-2-4\" data-name=\"social links container\">\n                    <a class=\"hover:opacity-60 transition-opacity\" data-kid=\"1-1-1-2-4-1\" data-name=\"twitter link\" href=\"#\">\n                        Twitter\n                    </a>\n                    <a class=\"hover:opacity-60 transition-opacity\" data-kid=\"1-1-1-2-4-2\" data-name=\"linkedin link\" href=\"#\">\n                        LinkedIn\n                    </a>\n                    <a class=\"hover:opacity-60 transition-opacity\" data-kid=\"1-1-1-2-4-3\" data-name=\"github link\" href=\"#\">\n                        GitHub\n                    </a>\n                </div>\n            </div>\n        </div>\n        <!-- Right: Stark Form -->\n        <div class=\"lg:col-span-7 lg:pl-16 flex flex-col justify-end\" data-kid=\"1-1-2\" data-name=\"contact form panel\">\n            <form class=\"flex flex-col gap-14 pt-4\" data-kid=\"1-1-2-1\" data-name=\"contact form\">\n                <div class=\"group relative\" data-kid=\"1-1-2-1-1\" data-name=\"name field container\">\n                    <label class=\"block text-sm font-bold uppercase tracking-widest text-[var(--text-muted)] mb-2\" data-kid=\"1-1-2-1-1-1\" data-name=\"name field label\" for=\"name\">\n                        01. What's your name?\n                    </label>\n                    <input class=\"w-full bg-transparent border-0 border-b border-[var(--border-color)] py-4 text-3xl md:text-5xl font-medium focus:ring-0 focus:border-[var(--text-primary)] focus:outline-none placeholder:text-[var(--text-muted)]/50 transition-colors rounded-none\" data-kid=\"1-1-2-1-1-2\" data-name=\"name input field\" id=\"name\" placeholder=\"John Doe\" type=\"text\"/>\n                </div>\n                <div class=\"group relative\" data-kid=\"1-1-2-1-2\" data-name=\"email field container\">\n                    <label class=\"block text-sm font-bold uppercase tracking-widest text-[var(--text-muted)] mb-2\" data-kid=\"1-1-2-1-2-1\" data-name=\"email field label\" for=\"email\">\n                        02. What's your email?\n                    </label>\n                    <input class=\"w-full bg-transparent border-0 border-b border-[var(--border-color)] py-4 text-3xl md:text-5xl font-medium focus:ring-0 focus:border-[var(--text-primary)] focus:outline-none placeholder:text-[var(--text-muted)]/50 transition-colors rounded-none\" data-kid=\"1-1-2-1-2-2\" data-name=\"email input field\" id=\"email\" placeholder=\"john@doe.com\" type=\"email\"/>\n                </div>\n                <div class=\"group relative\" data-kid=\"1-1-2-1-3\" data-name=\"message field container\">\n                    <label class=\"block text-sm font-bold uppercase tracking-widest text-[var(--text-muted)] mb-2\" data-kid=\"1-1-2-1-3-1\" data-name=\"message field label\" for=\"message\">\n                        03. Tell me about your project\n                    </label>\n                    <textarea class=\"w-full bg-transparent border-0 border-b border-[var(--border-color)] py-4 text-3xl md:text-5xl font-medium focus:ring-0 focus:border-[var(--text-primary)] focus:outline-none placeholder:text-[var(--text-muted)]/50 transition-colors resize-none rounded-none\" data-kid=\"1-1-2-1-3-2\" data-name=\"message text area\" id=\"message\" placeholder=\"Hello...\" rows=\"3\"></textarea>\n                </div>\n                <div class=\"mt-8\" data-kid=\"1-1-2-1-4\" data-name=\"submit button container\">\n                    <button class=\"btn btn-primary text-xl px-12 py-6 w-full md:w-auto uppercase tracking-wider font-bold\" data-kid=\"1-1-2-1-4-1\" data-name=\"send message button\" type=\"button\">\n                        Send Message\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n</section>\n",
      "comments": [],
      "created": "2026-09-07T12:50:00.314641+00:00",
      "modified": "2026-09-07T12:50:34.913712+00:00",
      "id": "var_4b0a93937d76"
    },
    "var_a4ebdc89fda6": {
      "type": "variant",
      "label": "Swiss - Education",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12420,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<section class=\"bg-[var(--bg-primary)] text-[var(--text-primary)] py-[var(--section-padding)] antialiased font-[family:var(--font-main)]\" data-kid=\"1\" data-name=\"education and experience section\" id=\"education\">\n    <div class=\"container mx-auto max-w-[var(--container-width)] px-6\" data-kid=\"1-1\" data-name=\"container\">\n        <!-- Section Header -->\n        <div class=\"flex flex-col md:flex-row md:items-end justify-between border-b border-[var(--border-color)] pb-8 mb-16 gap-6\" data-kid=\"1-1-1\" data-name=\"section header container\">\n            <h2 class=\"text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none m-0 p-0\" data-kid=\"1-1-1-1\" data-name=\"section title heading\">\n                Education\n                <br data-kid=\"1-1-1-1-1\" data-name=\"line break\"/>\n                & Experience\n            </h2>\n            <div class=\"text-right\" data-kid=\"1-1-1-2\" data-name=\"section metadata container\">\n                <p class=\"text-[var(--text-muted)] text-lg md:text-xl font-medium tracking-wide uppercase m-0\" data-kid=\"1-1-1-2-1\" data-name=\"section description label\">\n                    Curriculum Vitae\n                </p>\n                <p class=\"text-[var(--text-primary)] text-sm font-bold tracking-widest uppercase mt-2\" data-kid=\"1-1-1-2-2\" data-name=\"date range label\">\n                    2018 — Present\n                </p>\n            </div>\n        </div>\n        <!-- Timeline Grid -->\n        <div class=\"grid grid-cols-1 border-t border-l border-[var(--border-color)]\" data-kid=\"1-1-2\" data-name=\"timeline grid\">\n            <!-- Timeline Item 1 -->\n            <div class=\"grid grid-cols-1 md:grid-cols-12 border-b border-r border-[var(--border-color)] hover:bg-[var(--bg-card)] transition-colors duration-300\" data-kid=\"1-1-2-1\" data-name=\"timeline item 1\">\n                <div class=\"md:col-span-3 p-8 border-b md:border-b-0 md:border-r border-[var(--border-color)] flex flex-col justify-start\" data-kid=\"1-1-2-1-1\" data-name=\"timeline date container\">\n                    <span class=\"text-3xl md:text-4xl font-black tracking-tighter\" data-kid=\"1-1-2-1-1-1\" data-name=\"timeline date range\">\n                        2022 —\n                        <br data-kid=\"1-1-2-1-1-1-1\" data-name=\"line break\"/>\n                        Present\n                    </span>\n                </div>\n                <div class=\"md:col-span-9 p-8 flex flex-col justify-center\" data-kid=\"1-1-2-1-2\" data-name=\"timeline content container\">\n                    <h3 class=\"text-2xl md:text-4xl font-bold uppercase tracking-tight mb-2\" data-kid=\"1-1-2-1-2-1\" data-name=\"timeline item title\">\n                        Senior Frontend Developer\n                    </h3>\n                    <h4 class=\"text-xl text-[var(--accent-primary)] font-medium mb-6\" data-kid=\"1-1-2-1-2-2\" data-name=\"timeline item organization\">\n                        Tech Innovators Inc.\n                    </h4>\n                    <p class=\"text-lg leading-relaxed text-[var(--text-secondary)] max-w-3xl\" data-kid=\"1-1-2-1-2-3\" data-name=\"timeline item description\">\n                        Leading the frontend architecture for scalable web applications. Implementing complex UI systems using React, Tailwind CSS, and modern JavaScript frameworks. Focused on performance optimization and accessibility.\n                    </p>\n                </div>\n            </div>\n            <!-- Timeline Item 2 -->\n            <div class=\"grid grid-cols-1 md:grid-cols-12 border-b border-r border-[var(--border-color)] hover:bg-[var(--bg-card)] transition-colors duration-300\" data-kid=\"1-1-2-2\" data-name=\"timeline item 2\">\n                <div class=\"md:col-span-3 p-8 border-b md:border-b-0 md:border-r border-[var(--border-color)] flex flex-col justify-start\" data-kid=\"1-1-2-2-1\" data-name=\"timeline date container\">\n                    <span class=\"text-3xl md:text-4xl font-black tracking-tighter\" data-kid=\"1-1-2-2-1-1\" data-name=\"timeline date range\">\n                        2019 —\n                        <br data-kid=\"1-1-2-2-1-1-1\" data-name=\"line break\"/>\n                        2022\n                    </span>\n                </div>\n                <div class=\"md:col-span-9 p-8 flex flex-col justify-center\" data-kid=\"1-1-2-2-2\" data-name=\"timeline content container\">\n                    <h3 class=\"text-2xl md:text-4xl font-bold uppercase tracking-tight mb-2\" data-kid=\"1-1-2-2-2-1\" data-name=\"timeline item title\">\n                        Bachelor of Science in CS\n                    </h3>\n                    <h4 class=\"text-xl text-[var(--accent-primary)] font-medium mb-6\" data-kid=\"1-1-2-2-2-2\" data-name=\"timeline item organization\">\n                        University of Technology\n                    </h4>\n                    <p class=\"text-lg leading-relaxed text-[var(--text-secondary)] max-w-3xl\" data-kid=\"1-1-2-2-2-3\" data-name=\"timeline item description\">\n                        Specialized in software engineering, human-computer interaction, and web technologies. Graduated with Honors. Participated in multiple hackathons and open-source projects.\n                    </p>\n                </div>\n            </div>\n            <!-- Timeline Item 3 -->\n            <div class=\"grid grid-cols-1 md:grid-cols-12 border-b border-r border-[var(--border-color)] hover:bg-[var(--bg-card)] transition-colors duration-300\" data-kid=\"1-1-2-3\" data-name=\"timeline item 3\">\n                <div class=\"md:col-span-3 p-8 border-b md:border-b-0 md:border-r border-[var(--border-color)] flex flex-col justify-start\" data-kid=\"1-1-2-3-1\" data-name=\"timeline date container\">\n                    <span class=\"text-3xl md:text-4xl font-black tracking-tighter\" data-kid=\"1-1-2-3-1-1\" data-name=\"timeline date range\">\n                        2018 —\n                        <br data-kid=\"1-1-2-3-1-1-1\" data-name=\"line break\"/>\n                        2019\n                    </span>\n                </div>\n                <div class=\"md:col-span-9 p-8 flex flex-col justify-center\" data-kid=\"1-1-2-3-2\" data-name=\"timeline content container\">\n                    <h3 class=\"text-2xl md:text-4xl font-bold uppercase tracking-tight mb-2\" data-kid=\"1-1-2-3-2-1\" data-name=\"timeline item title\">\n                        Web Development Bootcamp\n                    </h3>\n                    <h4 class=\"text-xl text-[var(--accent-primary)] font-medium mb-6\" data-kid=\"1-1-2-3-2-2\" data-name=\"timeline item organization\">\n                        Code Academy\n                    </h4>\n                    <p class=\"text-lg leading-relaxed text-[var(--text-secondary)] max-w-3xl\" data-kid=\"1-1-2-3-2-3\" data-name=\"timeline item description\">\n                        Intensive 12-week program focusing on full-stack web development. Mastered HTML, CSS, JavaScript, and React. Built multiple functional prototypes and landing pages.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
      "comments": [],
