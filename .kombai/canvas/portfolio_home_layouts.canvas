      "html": "<section class=\"w-full bg-[var(--bg-primary)] text-[var(--text-primary)] font-sans py-24 md:py-32 selection:bg-[var(--text-primary)] selection:text-[var(--bg-primary)]\" data-kid=\"1\" data-name=\"education section\" id=\"education\">\n    <div class=\"max-w-[1100px] mx-auto px-6 md:px-12\" data-kid=\"1-1\" data-name=\"section content container\">\n        <div class=\"grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16\" data-kid=\"1-1-1\" data-name=\"section grid layout\">\n            <!-- Section Title -->\n            <div class=\"md:col-span-4\" data-kid=\"1-1-1-1\" data-name=\"title column\">\n                <div class=\"sticky top-24\" data-kid=\"1-1-1-1-1\" data-name=\"sticky title wrapper\">\n                    <h2 class=\"text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none break-words\" data-kid=\"1-1-1-1-1-1\" data-name=\"section heading\">\n                        Edu\n                        <br data-kid=\"1-1-1-1-1-1-1\" data-name=\"line break\"/>\n                        ca\n                        <br data-kid=\"1-1-1-1-1-1-2\" data-name=\"line break\"/>\n                        tion\n                    </h2>\n                    <div class=\"mt-8 h-1 w-16 bg-[var(--text-primary)]\" data-kid=\"1-1-1-1-1-2\" data-name=\"decorative underline\">\n                    </div>\n                </div>\n            </div>\n            <!-- Education List -->\n            <div class=\"md:col-span-8 flex flex-col\" data-kid=\"1-1-1-2\" data-name=\"education list container\">\n                <!-- Item 1 -->\n                <div class=\"border-t-2 border-[var(--border-color)] pt-8 pb-16 md:pt-12 md:pb-20 flex flex-col md:flex-row gap-4 md:gap-12 group transition-colors duration-300 hover:bg-[var(--bg-secondary)] -mx-6 px-6 sm:mx-0 sm:px-0 sm:hover:bg-transparent\" data-kid=\"1-1-1-2-1\" data-name=\"education item 1\">\n                    <div class=\"md:w-1/3 flex-shrink-0\" data-kid=\"1-1-1-2-1-1\" data-name=\"date range 1 container\">\n                        <p class=\"text-2xl md:text-3xl font-bold tracking-tighter text-[var(--accent-primary)]\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"date range 1\">\n                            2018 — 2022\n                        </p>\n                    </div>\n                    <div class=\"md:w-2/3 flex flex-col gap-3\" data-kid=\"1-1-1-2-1-2\" data-name=\"details 1 container\">\n                        <h3 class=\"text-3xl md:text-4xl font-bold tracking-tighter leading-tight text-[var(--text-primary)]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"degree title 1\">\n                            Bachelor of Science in Computer Science\n                        </h3>\n                        <p class=\"text-xl text-[var(--text-secondary)] font-medium tracking-tight\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"institution name 1\">\n                            University of Technology, San Francisco\n                        </p>\n                        <p class=\"text-base text-[var(--text-muted)] mt-4 max-w-lg leading-relaxed\" data-kid=\"1-1-1-2-1-2-3\" data-name=\"degree description 1\">\n                            Graduated with honors. Specialized in human-computer interaction and web technologies. Lead developer for the university's annual tech symposium.\n                        </p>\n                    </div>\n                </div>\n                <!-- Item 2 -->\n                <div class=\"border-t-2 border-[var(--border-color)] pt-8 pb-16 md:pt-12 md:pb-20 flex flex-col md:flex-row gap-4 md:gap-12 group transition-colors duration-300 hover:bg-[var(--bg-secondary)] -mx-6 px-6 sm:mx-0 sm:px-0 sm:hover:bg-transparent\" data-kid=\"1-1-1-2-2\" data-name=\"education item 2\">\n                    <div class=\"md:w-1/3 flex-shrink-0\" data-kid=\"1-1-1-2-2-1\" data-name=\"date range 2 container\">\n                        <p class=\"text-2xl md:text-3xl font-bold tracking-tighter text-[var(--accent-primary)]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"date range 2\">\n                            2016 — 2018\n                        </p>\n                    </div>\n                    <div class=\"md:w-2/3 flex flex-col gap-3\" data-kid=\"1-1-1-2-2-2\" data-name=\"details 2 container\">\n                        <h3 class=\"text-3xl md:text-4xl font-bold tracking-tighter leading-tight text-[var(--text-primary)]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"degree title 2\">\n                            Associate Degree in Graphic Design\n                        </h3>\n                        <p class=\"text-xl text-[var(--text-secondary)] font-medium tracking-tight\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"institution name 2\">\n                            Creative Arts College, New York\n                        </p>\n                        <p class=\"text-base text-[var(--text-muted)] mt-4 max-w-lg leading-relaxed\" data-kid=\"1-1-1-2-2-2-3\" data-name=\"degree description 2\">\n                            Focus on typography, layout systems, and digital media. Winner of the 2018 Student Design Award. Developed a passion for grid systems and minimalist interfaces.\n                        </p>\n                    </div>\n                </div>\n                <!-- Item 3 -->\n                <div class=\"border-t-2 border-b-2 border-[var(--border-color)] pt-8 pb-16 md:pt-12 md:pb-20 flex flex-col md:flex-row gap-4 md:gap-12 group transition-colors duration-300 hover:bg-[var(--bg-secondary)] -mx-6 px-6 sm:mx-0 sm:px-0 sm:hover:bg-transparent\" data-kid=\"1-1-1-2-3\" data-name=\"education item 3\">\n                    <div class=\"md:w-1/3 flex-shrink-0\" data-kid=\"1-1-1-2-3-1\" data-name=\"date range 3 container\">\n                        <p class=\"text-2xl md:text-3xl font-bold tracking-tighter text-[var(--accent-primary)]\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"date range 3\">\n                            2015\n                        </p>\n                    </div>\n                    <div class=\"md:w-2/3 flex flex-col gap-3\" data-kid=\"1-1-1-2-3-2\" data-name=\"details 3 container\">\n                        <h3 class=\"text-3xl md:text-4xl font-bold tracking-tighter leading-tight text-[var(--text-primary)]\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"degree title 3\">\n                            Certificate in Web Development\n                        </h3>\n                        <p class=\"text-xl text-[var(--text-secondary)] font-medium tracking-tight\" data-kid=\"1-1-1-2-3-2-2\" data-name=\"institution name 3\">\n                            Code Academy Bootcamps\n                        </p>\n                        <p class=\"text-base text-[var(--text-muted)] mt-4 max-w-lg leading-relaxed\" data-kid=\"1-1-1-2-3-2-3\" data-name=\"degree description 3\">\n                            Intensive 12-week program covering full-stack web development with JavaScript and React. Built multiple functional prototypes and landing pages.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
