        "h": 800
      },
      "html": "<section class=\"py-24 md:py-32 bg-[var(--bg-primary)] text-[var(--text-primary)] font-[family:var(--font-main)] antialiased overflow-hidden flex justify-center\" data-kid=\"1\" data-name=\"about section container\">\n    <div class=\"w-full max-w-[var(--container-width,1100px)] px-6 mx-auto\" data-kid=\"1-1\" data-name=\"section content wrapper\">\n        <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16\" data-kid=\"1-1-1\" data-name=\"layout grid container\">\n            <!-- Sidebar / Section Label -->\n            <div class=\"md:col-span-3\" data-kid=\"1-1-1-1\" data-name=\"sidebar container\">\n                <h2 class=\"text-xs uppercase tracking-[0.2em] font-bold text-[var(--text-muted)] border-b border-[var(--border-color)] pb-4 mb-8\" data-kid=\"1-1-1-1-1\" data-name=\"section label heading\">\n                    02 — About\n                </h2>\n            </div>\n            <!-- Main Prose Content -->\n            <div class=\"md:col-span-9 max-w-2xl\" data-kid=\"1-1-1-2\" data-name=\"prose content column\">\n                <p class=\"text-lg md:text-xl text-[var(--text-secondary)] leading-relaxed mb-8\" data-kid=\"1-1-1-2-1\" data-name=\"first paragraph text\">\n                    I am a multidisciplinary designer and developer with a focus on creating functional, beautiful, and accessible digital experiences. My approach is rooted in the principles of International Typographic Style—emphasizing clarity, readability, and objectivity.\n                </p>\n                <p class=\"text-lg md:text-xl text-[var(--text-secondary)] leading-relaxed mb-16\" data-kid=\"1-1-1-2-2\" data-name=\"second paragraph text\">\n                    Over the past decade, I have collaborated with startups and global enterprises to build scalable design systems and robust technical architectures. I believe that good design is as little design as possible.\n                </p>\n                <!-- Giant Pull Quote breaking the column -->\n                <div class=\"relative w-[calc(100%+2rem)] -ml-4 sm:w-[calc(100%+4rem)] sm:-ml-8 md:w-[calc(100%+12rem)] md:-ml-12 lg:-ml-24 my-20 py-12 md:py-16 border-t border-b border-[var(--text-primary)] bg-[var(--bg-secondary)] px-6 sm:px-8 md:px-12 lg:px-24\" data-kid=\"1-1-1-2-3\" data-name=\"pull quote container\">\n                    <blockquote class=\"text-3xl md:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight text-[var(--text-primary)]\" data-kid=\"1-1-1-2-3-1\" data-name=\"pull quote text\">\n                        \"Design must be functional and functionality must be translated into visual aesthetics, without any reliance on gimmicks.\"\n                    </blockquote>\n                </div>\n                <p class=\"text-lg md:text-xl text-[var(--text-secondary)] leading-relaxed mb-8\" data-kid=\"1-1-1-2-4\" data-name=\"third paragraph text\">\n                    By maintaining a strict grid and a constrained color palette, I ensure that the content always remains the focal point. My process involves rigorous research, rapid prototyping, and a commitment to refining every detail until the solution feels inevitable.\n                </p>\n                <p class=\"text-lg md:text-xl text-[var(--text-secondary)] leading-relaxed mb-16\" data-kid=\"1-1-1-2-5\" data-name=\"fourth paragraph text\">\n                    Currently, I am exploring the intersection of generative AI and user interface design, seeking new ways to enhance human-computer interaction without compromising on usability or introducing unnecessary friction.\n                </p>\n                <!-- Minimal Swiss Link -->\n                <a class=\"inline-flex items-center gap-3 text-[var(--text-primary)] font-bold uppercase tracking-widest text-sm border-b-2 border-[var(--text-primary)] pb-2 hover:text-[var(--accent-primary)] hover:border-[var(--accent-primary)] transition-colors duration-300 w-fit\" data-kid=\"1-1-1-2-6\" data-name=\"view full experience link\" href=\"#experience\">\n                    View Full Experience\n                    <svg class=\"w-4 h-4\" data-kid=\"1-1-1-2-6-1\" data-name=\"arrow icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M17 8l4 4m0 0l-4 4m4-4H3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"2\">\n                        </path>\n                    </svg>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>\n",
      "comments": [],
      "created": "2026-09-07T12:50:06.027102+00:00",
      "modified": "2026-09-07T12:50:34.127909+00:00",
      "id": "var_4db54d2d5363"
    },
    "var_cbff835d6010": {
      "type": "variant",
      "label": "Swiss - Home",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 15180,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<section class=\"w-full min-h-[90vh] bg-[var(--bg-primary)] text-[var(--text-primary)] font-sans flex flex-col border-b border-[var(--border-color)]\" data-kid=\"1\" data-name=\"landing page section\">\n    <div class=\"flex-1 grid grid-cols-1 md:grid-cols-12 w-full h-full\" data-kid=\"1-1\" data-name=\"layout grid\">\n        <!-- Sidebar / Meta -->\n        <div class=\"hidden md:flex md:col-span-1 border-r border-[var(--border-color)] flex-col justify-between p-8 relative items-center\" data-kid=\"1-1-1\" data-name=\"sidebar meta container\">\n            <div class=\"text-[var(--text-muted)] text-sm font-semibold uppercase tracking-widest rotate-[-90deg] origin-center whitespace-nowrap mt-12\" data-kid=\"1-1-1-1\" data-name=\"index number label\">\n                01 / Index\n            </div>\n            <div class=\"text-[var(--text-muted)] text-sm font-bold tracking-[0.2em] uppercase rotate-[-90deg] origin-center whitespace-nowrap mb-24\" data-kid=\"1-1-1-2\" data-name=\"portfolio section label\">\n                Portfolio\n            </div>\n        </div>\n        <!-- Main Content Area -->\n        <div class=\"col-span-1 md:col-span-7 border-r border-[var(--border-color)] p-8 md:p-16 lg:p-24 flex flex-col justify-center gap-12 bg-[var(--bg-secondary)] relative overflow-hidden\" data-kid=\"1-1-2\" data-name=\"hero content area\">\n            <!-- Decorative subtle grid -->\n            <div class=\"absolute inset-0 bg-[linear-gradient(to_right,var(--border-color)_1px,transparent_1px),linear-gradient(to_bottom,var(--border-color)_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-20 pointer-events-none\" data-kid=\"1-1-2-1\" data-name=\"decorative background grid\">\n            </div>\n            <div class=\"relative z-10\" data-kid=\"1-1-2-2\" data-name=\"hero headline group\">\n                <h1 class=\"text-[70px] sm:text-[100px] lg:text-[140px] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[var(--text-primary)] break-words mb-8 drop-shadow-[4px_4px_0_var(--border-color)]\" data-kid=\"1-1-2-2-1\" data-name=\"hero main heading\">\n                    DESIGN\n                    <br data-kid=\"1-1-2-2-1-1\" data-name=\"line break\"/>\n                    <span class=\"text-[var(--accent-primary)] mix-blend-multiply dark:mix-blend-screen\" data-kid=\"1-1-2-2-1-2\" data-name=\"hero highlight text\">\n                        CRAFT\n                    </span>\n                </h1>\n                <p class=\"text-xl md:text-2xl text-[var(--text-secondary)] font-medium max-w-xl leading-relaxed border-l-[6px] border-[var(--text-primary)] pl-6 py-2 bg-[var(--bg-primary)]/50 backdrop-blur-sm shadow-sm\" data-kid=\"1-1-2-2-2\" data-name=\"hero subheadline description\">\n                    I build objective, system-driven interfaces. Specializing in minimal aesthetics, clear typography, and robust performance.\n                </p>\n            </div>\n            <div class=\"pt-8 relative z-10\" data-kid=\"1-1-2-3\" data-name=\"cta button container\">\n                <button class=\"btn btn-primary rounded-none shadow-[6px_6px_0_var(--text-primary)] border-2 border-[var(--text-primary)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_var(--text-primary)] active:translate-y-[6px] active:translate-x-[6px] active:shadow-none transition-all duration-200\" data-kid=\"1-1-2-3-1\" data-name=\"view archive call-to-action button\">\n                    VIEW ARCHIVE\n                    <svg data-kid=\"1-1-2-3-1-1\" data-name=\"right arrow icon\" fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" stroke-width=\"3\" viewbox=\"0 0 24 24\" width=\"16\">\n                        <line x1=\"5\" x2=\"19\" y1=\"12\" y2=\"12\">\n                        </line>\n                        <polyline points=\"12 5 19 12 12 19\">\n                        </polyline>\n                    </svg>\n                </button>\n            </div>\n        </div>\n        <!-- Right Image Area -->\n        <div class=\"col-span-1 md:col-span-4 bg-[var(--bg-card)] flex flex-col min-h-[500px]\" data-kid=\"1-1-3\" data-name=\"image and status column\">\n            <div class=\"flex-1 relative border-b border-[var(--border-color)] overflow-hidden\" data-kid=\"1-1-3-1\" data-name=\"portrait image container\">\n                <img alt=\"Portrait\" class=\"absolute inset-0 w-full h-full object-cover grayscale contrast-125 hover:scale-105 transition-transform duration-[1.5s]\" data-kid=\"1-1-3-1-1\" data-name=\"designer portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1598897516650-e4dc73d8e417?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxCbGFjayUyMGFuZCUyMHdoaXRlJTIwcG9ydHJhaXQlMjBvZiUyMGElMjBkZXNpZ25lciUyMGxvb2tpbmclMjB0aG91Z2h0ZnVsbHklMjBvZmYlMjBjYW1lcmElMjBtaW5pbWFsJTIwYmFja2dyb3VuZHxlbnwwfHx8fDE3ODg3ODQ2MDd8MA&ixlib=rb-4.1.0&q=85\"/>\n                <!-- Gradient Overlay for better contrast with the theme -->\n                <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)]/80 to-transparent\" data-kid=\"1-1-3-1-2\" data-name=\"gradient overlay\">\n                </div>\n            </div>\n            <div class=\"p-8 flex items-center justify-between bg-[var(--bg-primary)]\" data-kid=\"1-1-3-2\" data-name=\"location and status footer\">\n                <div class=\"text-[var(--text-muted)] text-xs font-bold uppercase tracking-[0.15em] flex flex-col gap-1\" data-kid=\"1-1-3-2-1\" data-name=\"location text container\">\n                    Based in\n                    <span class=\"text-[var(--text-primary)] text-sm\" data-kid=\"1-1-3-2-1-1\" data-name=\"location name\">\n                        Myanmar\n                    </span>\n                </div>\n                <div class=\"text-[var(--text-muted)] text-xs font-bold uppercase tracking-[0.15em] flex flex-col gap-1 items-end\" data-kid=\"1-1-3-2-2\" data-name=\"status text container\">\n                    Status\n                    <span class=\"text-[var(--text-primary)] text-sm flex items-center gap-2\" data-kid=\"1-1-3-2-2-1\" data-name=\"availability status label\">\n                        <span class=\"w-2.5 h-2.5 rounded-none bg-[var(--accent-primary)] animate-pulse\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"pulsing availability indicator\">\n                        </span>\n                        Available\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n",
      "comments": [],
      "created": "2026-09-07T12:50:11.113000+00:00",
      "modified": "2026-09-07T12:50:34.919250+00:00",
      "id": "var_cbff835d6010"
